---
export const prerender = true
import Layout from '../layouts/Layout.astro'
import NavBar from '../components/NavBar.astro'
---

<Layout title="Página no encontrada · Radar Subvenciones" noindex={true}>
  <NavBar />

  <div class="max-w-3xl mx-auto px-4 py-24 text-center">
    <p class="text-6xl font-extrabold text-emerald-500 mb-4">404</p>
    <h1 class="text-xl font-bold text-slate-100 mb-3">Página no encontrada</h1>
    <p class="text-slate-400 text-sm mb-8">Es posible que la convocatoria haya caducado o el enlace sea incorrecto.</p>
    <a href="/" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-emerald-500 hover:bg-emerald-400 text-slate-950 text-sm font-semibold transition-colors">
      Ver todas las subvenciones
    </a>
  </div>

  <footer class="border-t border-slate-800/60 mt-10">
    <div class="max-w-5xl mx-auto px-4 py-8 flex flex-col sm:flex-row justify-between items-center gap-4 text-xs text-slate-600">
      <p>© {new Date().getFullYear()} Radar Subvenciones · Proyecto independiente</p>
      <nav class="flex flex-wrap gap-x-4 gap-y-1 justify-center">
        <a href="/origen-datos"        class="hover:text-slate-400 transition-colors">Fuentes</a>
        <a href="/aviso-legal"         class="hover:text-slate-400 transition-colors">Aviso legal</a>
        <a href="/politica-privacidad" class="hover:text-slate-400 transition-colors">Privacidad</a>
        <a href="/politica-cookies"    class="hover:text-slate-400 transition-colors">Cookies</a>
      </nav>
    </div>
  </footer>

</Layout>
