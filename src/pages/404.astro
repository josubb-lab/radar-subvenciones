---
import Layout from '../layouts/Layout.astro'
---

<Layout title="Página no encontrada · Radar Subvenciones" noindex={true}>
  <nav class="border-b border-slate-800 bg-slate-950/90 backdrop-blur sticky top-0 z-40">
    <div class="max-w-5xl mx-auto px-4 h-14 flex items-center gap-3">
      <a href="/" class="flex items-center gap-2 text-slate-400 hover:text-slate-100 transition-colors text-sm font-medium">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
        </svg>
        Radar Subvenciones
      </a>
    </div>
  </nav>

  <div class="max-w-3xl mx-auto px-4 py-24 text-center">
    <p class="text-6xl font-extrabold text-emerald-500 mb-4">404</p>
    <h1 class="text-xl font-bold text-slate-100 mb-3">Página no encontrada</h1>
    <p class="text-slate-400 text-sm mb-8">Es posible que la convocatoria haya caducado o el enlace sea incorrecto.</p>
    <a href="/" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-emerald-500 hover:bg-emerald-400 text-slate-950 text-sm font-semibold transition-colors">
      Ver todas las subvenciones
    </a>
  </div>
</Layout>
