---
export const prerender = true
import Layout from '../layouts/Layout.astro'
import { SITE } from '../lib/config'
import NavBar from '../components/NavBar.astro'

const pageTitle = 'Quiénes somos · Radar Subvenciones'
const pageDesc  = 'Radar Subvenciones, un producto de BenchDataLab, aplica datos, automatización y filtrado de señal para monitorizar ayudas y subvenciones para asesorías y gestorías.'

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      name: 'BenchDataLab',
      url: 'https://benchdatalab.com',
      email: 'josue@benchdatalab.com',
      description: pageDesc,
      foundingDate: '2024',
      areaServed: { '@type': 'Country', name: 'Spain' },
      knowsAbout: ['Subvenciones públicas', 'Ayudas empresariales', 'Automatización de datos', 'Filtrado de señal', 'Seguimiento de ayudas'],
    },
    {
      '@type': 'WebPage',
      name: pageTitle,
      url: `${SITE.siteUrl}/quienes-somos`,
      inLanguage: 'es',
    },
  ],
}
---

<Layout title={pageTitle} description={pageDesc} {jsonLd}>

  <NavBar breadcrumb={[{ label: 'Nosotros' }]} />

  <div class="max-w-3xl mx-auto px-4 py-16">

    <h1 class="text-3xl font-extrabold text-slate-100 mb-4">Quiénes somos</h1>
    <p class="text-slate-400 text-base mb-12 leading-relaxed">
      BenchDataLab es un laboratorio independiente de datos. Radar Subvenciones es uno de sus productos: una herramienta especializada para asesorías, gestorías y despachos que necesitan trabajar con oportunidades filtradas en lugar de listados genéricos.
    </p>

    <div class="space-y-10">

      <div class="rounded-xl border border-slate-800 bg-slate-900/60 p-6">
        <h2 class="text-lg font-bold text-slate-100 mb-3">BenchDataLab</h2>
        <p class="text-slate-400 text-sm leading-relaxed">
          BenchDataLab desarrolla productos especializados basados en datos, automatización y filtrado. El objetivo no es publicar más ruido, sino convertir información dispersa en herramientas operativas para profesionales que necesitan criterio y foco.
        </p>
      </div>

      <div class="rounded-xl border border-emerald-900/40 bg-emerald-950/20 p-6">
        <h2 class="text-lg font-bold text-slate-100 mb-3">Qué es Radar Subvenciones</h2>
        <p class="text-slate-300 text-sm leading-relaxed">
          Radar Subvenciones es un producto concreto de BenchDataLab para detectar, ordenar y entregar oportunidades de subvenciones con valor para asesorías y gestorías. El resultado es un feed comercial en CSV o Excel con señal útil, prioridad y contexto suficiente para trabajar una cartera de clientes.
        </p>
      </div>

      <div class="rounded-xl border border-slate-800 bg-slate-900/60 p-6">
        <h2 class="text-lg font-bold text-slate-100 mb-3">Cómo trabajamos</h2>
        <ul class="space-y-3 text-sm text-slate-400">
          <li class="flex gap-3">
            <span class="text-emerald-400 font-bold shrink-0">01</span>
            <span>Revisamos nuevas convocatorias y cambios relevantes para identificar oportunidades con utilidad real para despachos.</span>
          </li>
          <li class="flex gap-3">
            <span class="text-emerald-400 font-bold shrink-0">02</span>
            <span>Aplicamos automatización y reglas de clasificación para ordenar la información por beneficiario, sector, ámbito y potencial comercial.</span>
          </li>
          <li class="flex gap-3">
            <span class="text-emerald-400 font-bold shrink-0">03</span>
            <span>Filtramos señal frente a ruido: no basta con detectar convocatorias, hay que priorizar las que realmente sirven a una cartera de clientes.</span>
          </li>
          <li class="flex gap-3">
            <span class="text-emerald-400 font-bold shrink-0">04</span>
            <span>Entregamos CSV o Excel preparados para revisión interna, priorización y activación comercial dentro del despacho.</span>
          </li>
        </ul>
      </div>

      <div class="rounded-xl border border-slate-800 bg-slate-900/60 p-6">
        <h2 class="text-lg font-bold text-slate-100 mb-3">Lo que no somos</h2>
        <p class="text-slate-400 text-sm leading-relaxed">
          No somos un portal público generalista. No somos Radar Bomberos. No prometemos una experiencia de búsqueda manual ni una actualización pública continua como propuesta principal. El foco está en el producto: seguimiento, filtrado de señal y entregables útiles para asesorías, gestorías y despachos.
        </p>
      </div>

      <div class="rounded-xl border border-emerald-800/40 bg-emerald-950/20 p-6">
        <h2 class="text-lg font-bold text-slate-100 mb-3">Contacto</h2>
        <p class="text-slate-400 text-sm mb-4">
          Para pedir una muestra, consultar un filtrado puntual o valorar seguimiento recurrente:
        </p>
        <a href="mailto:josue@benchdatalab.com" class="text-emerald-400 hover:underline text-sm font-semibold">
          josue@benchdatalab.com
        </a>
        <p class="text-slate-500 text-sm mt-3">
          BenchDataLab: <a href="https://benchdatalab.com" class="text-emerald-400 hover:underline" target="_blank" rel="noreferrer">benchdatalab.com</a>
        </p>
      </div>

    </div>
  </div>

  <footer class="border-t border-slate-800/60 mt-10">
    <div class="max-w-5xl mx-auto px-4 py-8 grid md:grid-cols-[1.1fr_0.9fr] gap-6 text-xs text-slate-500">
      <div>
        <p class="text-slate-200 font-semibold">Radar Subvenciones</p>
        <p class="mt-1">Un producto de BenchDataLab</p>
        <p class="mt-1">laboratorio independiente de datos</p>
        <p class="mt-3">
          Contacto:
          <a href="mailto:josue@benchdatalab.com" class="text-emerald-400 hover:underline">josue@benchdatalab.com</a>
        </p>
      </div>
      <nav class="flex flex-wrap content-start gap-x-4 gap-y-2 justify-start md:justify-end">
        <a href="/" class="hover:text-slate-300 transition-colors">Inicio</a>
        <a href="/asesorias" class="hover:text-slate-300 transition-colors">Asesorías</a>
        <a href="/quienes-somos" class="hover:text-slate-300 transition-colors">Quiénes somos</a>
        <a href="https://benchdatalab.com" class="hover:text-slate-300 transition-colors" target="_blank" rel="noreferrer">BenchDataLab</a>
      </nav>
    </div>
  </footer>

</Layout>
