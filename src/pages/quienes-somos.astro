---
export const prerender = true
import Layout from '../layouts/Layout.astro'
import { SITE } from '../lib/config'
import NavBar from '../components/NavBar.astro'

const pageTitle = 'Quiénes somos · Radar Subvenciones'
const pageDesc  = 'Radar Subvenciones, un producto de BenchDataLab, aplica datos, automatización y filtrado de señal para monitorizar ayudas y subvenciones para asesorías y gestorías.'

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      name: 'BenchDataLab',
      url: SITE.siteUrl,
      email: 'josue@benchdatalab.com',
      description: pageDesc,
      foundingDate: '2024',
      areaServed: { '@type': 'Country', name: 'Spain' },
      knowsAbout: ['Subvenciones públicas', 'Ayudas empresariales', 'Automatización de datos', 'BDNS', 'BOE'],
    },
    {
      '@type': 'WebPage',
      name: pageTitle,
      url: `${SITE.siteUrl}/quienes-somos`,
      inLanguage: 'es',
    },
  ],
}
---

<Layout title={pageTitle} description={pageDesc} {jsonLd}>

  <NavBar breadcrumb={[{ label: 'Nosotros' }]} />

  <div class="max-w-3xl mx-auto px-4 py-16">

    <h1 class="text-3xl font-extrabold text-slate-100 mb-4">Quiénes somos</h1>
    <p class="text-slate-400 text-base mb-12 leading-relaxed">
      Radar Subvenciones es un producto de BenchDataLab, un laboratorio independiente de datos. Nuestro trabajo consiste en monitorizar ayudas, automatizar procesos de lectura y filtrar señal útil para que asesorías, gestorías y despachos trabajen mejor las oportunidades de subvención.
    </p>

    <div class="space-y-10">

      <div class="rounded-xl border border-slate-800 bg-slate-900/50 p-6">
        <h2 class="text-lg font-bold text-slate-100 mb-3">Nuestra misión</h2>
        <p class="text-slate-400 text-sm leading-relaxed">
          Construimos productos especializados de datos que convierten información dispersa en herramientas operativas. En Radar Subvenciones, eso significa transformar señales públicas en un feed comercial de ayudas filtradas para asesorías, gestorías y despachos.
        </p>
      </div>

      <div class="rounded-xl border border-slate-800 bg-slate-900/50 p-6">
        <h2 class="text-lg font-bold text-slate-100 mb-3">Metodología</h2>
        <ul class="space-y-3 text-sm text-slate-400">
          <li class="flex gap-3">
            <span class="text-emerald-400 font-bold shrink-0">01</span>
            <span>Monitorizamos BDNS, BOE y otras publicaciones relacionadas para detectar nuevas ayudas y cambios relevantes.</span>
          </li>
          <li class="flex gap-3">
            <span class="text-emerald-400 font-bold shrink-0">02</span>
            <span>Aplicamos automatización y reglas de clasificación para ordenar la información por beneficiario, sector, ámbito y potencial comercial.</span>
          </li>
          <li class="flex gap-3">
            <span class="text-emerald-400 font-bold shrink-0">03</span>
            <span>Filtramos señal frente a ruido: no basta con detectar convocatorias, hay que priorizar las que realmente sirven a una cartera de clientes.</span>
          </li>
          <li class="flex gap-3">
            <span class="text-emerald-400 font-bold shrink-0">04</span>
            <span>Enlazamos siempre a la fuente oficial original para validación y tramitación. El producto es la capa de datos y filtrado, no la sustitución de la fuente pública.</span>
          </li>
        </ul>
      </div>

      <div class="rounded-xl border border-slate-800 bg-slate-900/50 p-6">
        <h2 class="text-lg font-bold text-slate-100 mb-3">Producto especializado para despachos</h2>
        <p class="text-slate-400 text-sm leading-relaxed">
          Radar Subvenciones no pretende ser un portal genérico más. Está orientado a asesorías, gestorías, consultoras y despachos que necesitan ahorrar tiempo, detectar oportunidades antes y trabajar con datos filtrados en lugar de boletines sin procesar.
        </p>
      </div>

      <div class="rounded-xl border border-emerald-800/40 bg-emerald-950/20 p-6">
        <h2 class="text-lg font-bold text-slate-100 mb-3">Contacto</h2>
        <p class="text-slate-400 text-sm mb-4">
          Para consultas, demos o colaboraciones sobre Radar Subvenciones:
        </p>
        <a href="mailto:josue@benchdatalab.com" class="text-emerald-400 hover:underline text-sm font-semibold">
          josue@benchdatalab.com
        </a>
        <p class="text-slate-500 text-sm mt-3">
          BenchDataLab: <a href="https://benchdatalab.com" class="text-emerald-400 hover:underline" target="_blank" rel="noreferrer">benchdatalab.com</a>
        </p>
      </div>

    </div>
  </div>

  <footer class="border-t border-slate-800/60 mt-10">
    <div class="max-w-5xl mx-auto px-4 py-8 flex flex-col sm:flex-row justify-between items-center gap-4 text-xs text-slate-600">
      <p>© {new Date().getFullYear()} Radar Subvenciones · Un producto de BenchDataLab</p>
      <nav class="flex flex-wrap gap-x-4 gap-y-1 justify-center">
        <a href="https://benchdatalab.com" class="hover:text-slate-400 transition-colors" target="_blank" rel="noreferrer">BenchDataLab</a>
        <a href="/origen-datos"        class="hover:text-slate-400 transition-colors">Fuentes</a>
        <a href="/aviso-legal"         class="hover:text-slate-400 transition-colors">Aviso legal</a>
        <a href="/politica-privacidad" class="hover:text-slate-400 transition-colors">Privacidad</a>
        <a href="/politica-cookies"    class="hover:text-slate-400 transition-colors">Cookies</a>
      </nav>
    </div>
  </footer>

</Layout>
