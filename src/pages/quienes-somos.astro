---
export const prerender = true
import Layout from '../layouts/Layout.astro'
import { SITE } from '../lib/config'
import NavBar from '../components/NavBar.astro'

const pageTitle = 'Quiénes somos · Radar Subvenciones'
const pageDesc  = 'Radar Subvenciones, un producto de BenchDataLab, aplica datos, automatización y filtrado de señal para monitorizar ayudas y subvenciones para asesorías y gestorías.'

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      name: 'BenchDataLab',
      url: 'https://benchdatalab.com',
      email: 'josue@benchdatalab.com',
      description: pageDesc,
      foundingDate: '2024',
      areaServed: { '@type': 'Country', name: 'Spain' },
      knowsAbout: ['Subvenciones públicas', 'Ayudas empresariales', 'Automatización de datos', 'Filtrado de señal', 'Seguimiento de ayudas'],
    },
    {
      '@type': 'WebPage',
      name: pageTitle,
      url: `${SITE.siteUrl}/quienes-somos`,
      inLanguage: 'es',
    },
  ],
}
---

<Layout title={pageTitle} description={pageDesc} {jsonLd} showAds={false}>

  <NavBar breadcrumb={[{ label: 'Nosotros' }]} />

  <div class="max-w-3xl mx-auto px-4 py-14">

    <h1 class="text-3xl font-extrabold text-slate-100 mb-3">Quiénes somos</h1>
    <p class="text-slate-400 text-sm mb-10 leading-relaxed">
      Radar Subvenciones es un producto de <a href="https://benchdatalab.com" class="text-slate-300 hover:text-slate-100 transition-colors" target="_blank" rel="noreferrer">BenchDataLab</a>, laboratorio independiente de datos. Filtramos convocatorias públicas y las entregamos en CSV o Excel para asesorías, gestorías y despachos profesionales.
    </p>

    <div class="space-y-5">

      <div class="rounded-xl border border-emerald-900/40 bg-emerald-950/20 p-6">
        <h2 class="text-base font-bold text-slate-100 mb-3">Qué es Radar Subvenciones</h2>
        <p class="text-slate-300 text-sm leading-relaxed">
          Un servicio de seguimiento y filtrado de subvenciones públicas orientado a uso profesional. El resultado es un entregable periódico en CSV o Excel con las convocatorias relevantes para tu cartera: clasificadas por destinatario, territorio, importe y prioridad, con motivo de selección y enlace oficial.
        </p>
        <p class="text-slate-400 text-sm leading-relaxed mt-3">
          No es un portal de búsqueda. No indexamos todas las ayudas disponibles. El producto está pensado para reducir el tiempo que un despacho dedica a detectar oportunidades de subvención para sus clientes.
        </p>
      </div>

      <div class="rounded-xl border border-slate-800 bg-slate-900/60 p-6">
        <h2 class="text-base font-bold text-slate-100 mb-4">Cómo funciona</h2>
        <ul class="space-y-3 text-sm text-slate-400">
          <li class="flex gap-3">
            <span class="text-emerald-400 font-bold shrink-0">01</span>
            <span>Monitorizamos fuentes públicas de convocatorias y las procesamos de forma continua.</span>
          </li>
          <li class="flex gap-3">
            <span class="text-emerald-400 font-bold shrink-0">02</span>
            <span>Aplicamos clasificación automática por destinatario, sector, territorio y relevancia comercial.</span>
          </li>
          <li class="flex gap-3">
            <span class="text-emerald-400 font-bold shrink-0">03</span>
            <span>Filtramos ruido: descartamos convocatorias sin utilidad operativa para una cartera de clientes.</span>
          </li>
          <li class="flex gap-3">
            <span class="text-emerald-400 font-bold shrink-0">04</span>
            <span>Entregamos el resultado en CSV o Excel, listo para revisar con el equipo o compartir con el cliente.</span>
          </li>
        </ul>
      </div>

      <div class="rounded-xl border border-slate-800 bg-slate-900/60 p-6">
        <h2 class="text-base font-bold text-slate-100 mb-3">Lo que no somos</h2>
        <p class="text-slate-400 text-sm leading-relaxed">
          No somos un portal público generalista de búsqueda de subvenciones. No ofrecemos acceso directo al BOE ni una base de datos navegable. El producto es un entregable filtrado y priorizado, no una herramienta de búsqueda libre.
        </p>
      </div>

      <div class="rounded-xl border border-emerald-800/40 bg-emerald-950/20 p-6">
        <h2 class="text-base font-bold text-slate-100 mb-3">Contacto</h2>
        <p class="text-slate-400 text-sm mb-3">Para pedir una muestra, consultar un filtrado puntual o valorar seguimiento recurrente:</p>
        <p class="text-emerald-400 text-sm font-medium">josue@benchdatalab.com</p>
        <p class="text-slate-500 text-sm mt-3">
          <a href="https://benchdatalab.com" class="hover:text-slate-300 transition-colors" target="_blank" rel="noreferrer">benchdatalab.com</a>
        </p>
      </div>

    </div>
  </div>

  <footer class="border-t border-slate-800/40 mt-10">
    <div class="max-w-5xl mx-auto px-4 py-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs text-slate-600">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
        <span class="text-slate-400 font-medium">Radar Subvenciones</span>
        <span class="text-slate-700">·</span>
        <span>Un producto de <a href="https://benchdatalab.com" class="hover:text-slate-400 transition-colors" target="_blank" rel="noreferrer">BenchDataLab</a></span>
      </div>
      <nav class="flex flex-wrap items-center gap-x-3 gap-y-1">
        <a href="/aviso-legal" class="text-slate-700 hover:text-slate-500 transition-colors">Aviso legal</a>
        <a href="/politica-privacidad" class="text-slate-700 hover:text-slate-500 transition-colors">Privacidad</a>
        <a href="/politica-cookies" class="text-slate-700 hover:text-slate-500 transition-colors">Cookies</a>
      </nav>
    </div>
  </footer>

</Layout>
