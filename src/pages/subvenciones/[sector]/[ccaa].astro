---
export const prerender = true
import Layout from '../../../layouts/Layout.astro'
import { createClient } from '@supabase/supabase-js'
import { SECTORES, CCAA, slugToSector, slugToCCAA } from '../../../lib/taxonomia'
import { subvencionSlug } from '../../../lib/slugify'
import NavBar from '../../../components/NavBar.astro'
import { SITE } from '../../../lib/config'

export function getStaticPaths() {
  const paths = []
  for (const sector of SECTORES) {
    for (const ccaa of CCAA) {
      paths.push({ params: { sector: sector.slug, ccaa: ccaa.slug } })
    }
  }
  return paths
}

const { sector, ccaa } = Astro.params
const sectorData  = slugToSector(sector)
const ccaaData    = slugToCCAA(ccaa)
const nombreSector = sectorData?.nombre ?? sector
const nombreCCAA   = ccaaData?.nombre ?? ccaa

const supabase = createClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.PUBLIC_SUPABASE_KEY,
)

const { data: subvenciones } = await supabase
  .from('subvenciones')
  .select('id, titulo, organismo, descripcion, importe_texto, fecha_pub, fecha_cierre, tipo, url')
  .eq('activa', true)
  .contains('sector', [sector])
  .contains('ccaa', [ccaa])
  .order('fecha_pub', { ascending: false, nullsFirst: false })
  .limit(100)

const total = subvenciones?.length ?? 0

const pageTitle = `Subvenciones para ${nombreSector} en ${nombreCCAA} · Radar Subvenciones`
const pageDesc  = `${total > 0 ? total : 'Últimas'} convocatorias de subvenciones y ayudas públicas para ${nombreSector} en ${nombreCCAA}. Actualizadas a diario desde el BOE y boletines autonómicos.`
const pageUrl   = `${SITE.siteUrl}/subvenciones/${sector}/${ccaa}`

const TIPO_META: Record<string, { label: string; color: string }> = {
  convocatoria: { label: 'Convocatoria', color: 'text-emerald-400 bg-emerald-950/60 ring-emerald-700/50' },
  extracto:     { label: 'Extracto BOE', color: 'text-sky-400 bg-sky-950/60 ring-sky-700/50' },
  bases:        { label: 'Bases',         color: 'text-amber-400 bg-amber-950/60 ring-amber-700/50' },
  resolucion:   { label: 'Resolución',   color: 'text-rose-400 bg-rose-950/60 ring-rose-700/50' },
}
function tipoMeta(tipo: string) {
  return TIPO_META[tipo] ?? { label: tipo ?? 'Ayuda', color: 'text-slate-400 bg-slate-800 ring-slate-700/50' }
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      name: pageTitle,
      description: pageDesc,
      url: pageUrl,
      inLanguage: 'es',
      isPartOf: { '@type': 'WebSite', url: SITE.siteUrl },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE.siteUrl },
        { '@type': 'ListItem', position: 2, name: `Subvenciones para ${nombreSector}`, item: `${SITE.siteUrl}/sector/${sector}` },
        { '@type': 'ListItem', position: 3, name: nombreCCAA, item: pageUrl },
      ],
    },
  ],
}
---

<Layout title={pageTitle} description={pageDesc} {jsonLd} noindex={total === 0}>

  <NavBar breadcrumb={[{ label: nombreSector, href: `/sector/${sector}` }, { label: nombreCCAA }]} />

  <section class="bg-gradient-to-b from-emerald-950/20 to-slate-950 border-b border-slate-800/60">
    <div class="max-w-5xl mx-auto px-4 py-12 lg:py-16">
      <p class="text-emerald-400 text-xs font-semibold uppercase tracking-widest mb-3">{nombreCCAA}</p>
      <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight text-slate-50 leading-tight mb-3">
        Subvenciones para {nombreSector} en {nombreCCAA}
      </h1>
      <p class="text-slate-400 text-base max-w-2xl">
        {total > 0
          ? `${total} convocatorias activas para ${nombreSector} en ${nombreCCAA}, actualizadas a diario desde el BOE y el boletín autonómico.`
          : `Monitorizamos diariamente las convocatorias para ${nombreSector} en ${nombreCCAA}. Vuelve pronto o consulta las ayudas nacionales.`
        }
      </p>

      <div class="flex flex-wrap gap-2 mt-6">
        {['2024','2025','2026'].map(a => (
          <a href={`/subvenciones/${sector}/${ccaa}/${a}`} class="text-xs px-3 py-1 rounded-full border border-slate-700 text-slate-400 hover:border-emerald-600 hover:text-emerald-400 transition-colors">
            {a}
          </a>
        ))}
        <span class="text-slate-700 text-xs px-1">·</span>
        <a href={`/sector/${sector}`} class="text-xs px-3 py-1 rounded-full border border-slate-700 text-slate-500 hover:text-slate-300 transition-colors">
          Todo {nombreSector} →
        </a>
        <a href={`/ccaa/${ccaa}`} class="text-xs px-3 py-1 rounded-full border border-slate-700 text-slate-500 hover:text-slate-300 transition-colors">
          Todo {nombreCCAA} →
        </a>
      </div>
    </div>
  </section>

  <main class="max-w-5xl mx-auto px-4 py-10">
    {total === 0 ? (
      <div class="rounded-xl border border-slate-800 bg-slate-900/50 p-8 text-center">
        <p class="text-slate-400 text-sm mb-4">No hay convocatorias activas en este momento para {nombreSector} en {nombreCCAA}.</p>
        <div class="flex flex-wrap gap-3 justify-center">
          <a href={`/sector/${sector}`} class="text-sm text-emerald-400 hover:underline">Ver todas las ayudas para {nombreSector}</a>
          <a href={`/ccaa/${ccaa}`} class="text-sm text-sky-400 hover:underline">Ver todas las ayudas en {nombreCCAA}</a>
        </div>
      </div>
    ) : (
      <ol class="space-y-4">
        {(subvenciones ?? []).map(s => {
          const tm = tipoMeta(s.tipo)
          const fechaPub = s.fecha_pub
            ? new Date(s.fecha_pub).toLocaleDateString('es-ES', { day: '2-digit', month: 'short', year: 'numeric' })
            : null
          const fechaCierre = s.fecha_cierre
            ? new Date(s.fecha_cierre).toLocaleDateString('es-ES', { day: '2-digit', month: 'short', year: 'numeric' })
            : null
          const slug = subvencionSlug(s.titulo ?? '', s.id)
          return (
            <li class="rounded-xl border border-slate-800 bg-slate-900/50 p-5 hover:border-slate-700 transition-colors">
              <div class="flex flex-wrap items-center gap-2 mb-2">
                <span class={`inline-flex items-center gap-1 text-[11px] font-semibold px-2 py-0.5 rounded-full ring-1 ${tm.color}`}>
                  {tm.label}
                </span>
                {s.importe_texto && (
                  <span class="text-[11px] font-semibold px-2 py-0.5 rounded-full ring-1 text-emerald-400 bg-emerald-950/60 ring-emerald-700/50">
                    {s.importe_texto}
                  </span>
                )}
                {fechaPub && <time class="text-xs text-slate-500 ml-auto">{fechaPub}</time>}
              </div>
              <a href={`/subvencion/${slug}`} class="block text-sm font-semibold text-slate-100 leading-snug mb-1 hover:text-emerald-400 transition-colors">
                {s.titulo}
              </a>
              {s.organismo && <p class="text-xs text-slate-500 mb-2">{s.organismo}</p>}
              {s.descripcion && (
                <p class="text-xs text-slate-500 leading-relaxed line-clamp-2">
                  {s.descripcion.slice(0, 200)}
                </p>
              )}
              {fechaCierre && (
                <p class="text-xs text-amber-500/80 mt-2">Plazo: hasta el {fechaCierre}</p>
              )}
            </li>
          )
        })}
      </ol>
    )}
  </main>

  <footer class="border-t border-slate-800/60 mt-10">
    <div class="max-w-5xl mx-auto px-4 py-8 flex flex-col sm:flex-row justify-between items-center gap-4 text-xs text-slate-600">
      <p>© {new Date().getFullYear()} Radar Subvenciones · Proyecto independiente</p>
      <nav class="flex flex-wrap gap-x-4 gap-y-1 justify-center">
        <a href="/origen-datos"        class="hover:text-slate-400 transition-colors">Fuentes</a>
        <a href="/aviso-legal"         class="hover:text-slate-400 transition-colors">Aviso legal</a>
        <a href="/politica-privacidad" class="hover:text-slate-400 transition-colors">Privacidad</a>
        <a href="/politica-cookies"    class="hover:text-slate-400 transition-colors">Cookies</a>
      </nav>
    </div>
  </footer>

</Layout>
