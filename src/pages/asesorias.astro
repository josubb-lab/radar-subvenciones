---
import Layout from '../layouts/Layout.astro'
import NavBar from '../components/NavBar.astro'
import { SITE } from '../lib/config'
import B2BFeedSample from '../components/B2BFeedSample.astro'

const pageTitle = 'Feed de Subvenciones para Asesorías · Radar Subvenciones'
const pageDesc = 'Feed CSV o Excel de subvenciones filtradas para asesorías, gestorías y consultoras: convocatorias priorizadas y listas para accionar.'

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: 'Feed de subvenciones para asesorías',
      provider: { '@type': 'Organization', name: SITE.nombre, url: SITE.siteUrl },
      areaServed: { '@type': 'Country', name: 'Spain' },
      description: pageDesc,
      serviceType: 'Feed comercial de subvenciones y seguimiento para despachos',
      url: `${SITE.siteUrl}/asesorias`,
    },
  ],
}
---

<Layout title={pageTitle} description={pageDesc} jsonLd={jsonLd}>
  <NavBar breadcrumb={[{ label: 'Asesorías' }]} />

  <main class="max-w-5xl mx-auto px-4 py-10 space-y-10">
    <section class="rounded-3xl border border-slate-800 bg-gradient-to-br from-emerald-950/40 via-slate-900 to-slate-950 p-8 lg:p-10">
      <p class="text-emerald-400 text-xs font-semibold uppercase tracking-[0.2em] mb-3">Radar Subvenciones · Un producto de BenchDataLab</p>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-50 leading-tight mb-4">
        Feed CSV/Excel de subvenciones filtradas para asesorías y gestorías
      </h1>
      <p class="text-slate-300 text-lg max-w-3xl mb-6">
        Recibe una selección comercial de ayudas para pymes, autónomos, empresas, empleo, contratación, comercio local y digitalización. Datos filtrados, señal útil y entregables preparados para ahorrar tiempo a tu despacho.
      </p>
      <div class="flex flex-wrap gap-3">
        <a
          href="mailto:josue@benchdatalab.com?subject=Solicitud%20Radar%20Subvenciones"
          class="inline-flex items-center justify-center px-5 py-3 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 text-sm font-bold transition-colors"
        >
          Escribir para pedir muestra
        </a>
        <a
          href="#como-funciona"
          class="inline-flex items-center justify-center px-5 py-3 rounded-xl border border-slate-700 hover:border-emerald-600 text-slate-200 text-sm font-semibold transition-colors"
        >
          Ver cómo funciona
        </a>
      </div>
    </section>

    <section class="grid lg:grid-cols-3 gap-4">
      <div class="rounded-2xl border border-slate-800 bg-slate-900/70 p-5">
        <p class="text-xs font-semibold uppercase tracking-widest text-slate-500 mb-2">Qué entregamos</p>
        <p class="text-sm text-slate-300">CSV o Excel con oportunidades filtradas, beneficiario objetivo, sector, ámbito, score comercial, motivo y enlace oficial.</p>
      </div>
      <div class="rounded-2xl border border-emerald-900/60 bg-emerald-950/20 p-5">
        <p class="text-xs font-semibold uppercase tracking-widest text-slate-500 mb-2">Qué ahorra</p>
        <p class="text-sm text-slate-300">Horas de lectura de boletines, revisión manual y pérdida de oportunidades por llegar tarde.</p>
      </div>
      <div class="rounded-2xl border border-slate-800 bg-slate-900/70 p-5">
        <p class="text-xs font-semibold uppercase tracking-widest text-slate-500 mb-2">Para quién</p>
        <p class="text-sm text-slate-300">Gestorías, despachos, asesorías fiscales, consultoras de subvenciones y agencias que tramitan ayudas para terceros.</p>
      </div>
    </section>

    <section class="grid lg:grid-cols-3 gap-5">
      <article class="rounded-2xl border border-slate-800 bg-slate-900/50 p-6">
        <p class="text-xs font-semibold uppercase tracking-widest text-slate-500 mb-3">Filtrados puntuales</p>
        <p class="text-sm text-slate-300">Para campañas concretas, clientes clave o necesidades de revisión rápida.</p>
      </article>
      <article class="rounded-2xl border border-emerald-800/40 bg-emerald-950/20 p-6">
        <p class="text-xs font-semibold uppercase tracking-widest text-emerald-400 mb-3">Seguimiento recurrente</p>
        <p class="text-sm text-slate-300">Para despachos que necesitan un flujo estable de oportunidades filtradas.</p>
      </article>
      <article class="rounded-2xl border border-slate-800 bg-slate-900/50 p-6">
        <p class="text-xs font-semibold uppercase tracking-widest text-slate-500 mb-3">Cobertura personalizada</p>
        <p class="text-sm text-slate-300">Ajustes por comunidad, vertical, tipo de cartera o perfil de cliente.</p>
      </article>
    </section>

    <section id="como-funciona" class="rounded-2xl border border-slate-800 bg-slate-900/50 p-6">
      <h2 class="text-xl font-bold text-slate-100 mb-4">Cómo funciona</h2>
      <div class="grid md:grid-cols-4 gap-4 text-sm text-slate-300">
        <div>
          <p class="text-emerald-400 font-semibold mb-1">1. Detección</p>
          <p>Revisamos convocatorias y publicaciones relevantes para localizar nuevas oportunidades con valor comercial.</p>
        </div>
        <div>
          <p class="text-emerald-400 font-semibold mb-1">2. Filtro comercial</p>
          <p>Quitamos ruido y priorizamos empleo, autónomos, empresas, comercio local, digitalización e innovación aplicable.</p>
        </div>
        <div>
          <p class="text-emerald-400 font-semibold mb-1">3. Entrega</p>
          <p>Recibes un CSV o Excel claro, con prioridad, motivo comercial, beneficiario, ámbito y enlace oficial.</p>
        </div>
        <div>
          <p class="text-emerald-400 font-semibold mb-1">4. Activación</p>
          <p>Tu despacho decide qué oportunidades mover primero con su cartera.</p>
        </div>
      </div>
    </section>

    <section class="rounded-2xl border border-slate-800 bg-slate-900/50 p-6">
      <h2 class="text-xl font-bold text-slate-100 mb-4">Casos de uso para despachos</h2>
      <div class="grid md:grid-cols-3 gap-4 text-sm text-slate-300">
        <div class="rounded-xl border border-slate-800 bg-slate-950/60 p-4">
          <p class="font-semibold text-slate-100 mb-2">Cartera pyme</p>
          <p class="text-slate-400">Seguimiento de ayudas para inversión, digitalización, empleo y expansión.</p>
        </div>
        <div class="rounded-xl border border-slate-800 bg-slate-950/60 p-4">
          <p class="font-semibold text-slate-100 mb-2">Autónomos y microempresa</p>
          <p class="text-slate-400">Detección rápida de convocatorias útiles sin revisar boletines completos.</p>
        </div>
        <div class="rounded-xl border border-slate-800 bg-slate-950/60 p-4">
          <p class="font-semibold text-slate-100 mb-2">Cobertura especializada</p>
          <p class="text-slate-400">Apoyo para despachos con sectores o territorios concretos que requieren más foco.</p>
        </div>
      </div>
    </section>

    <B2BFeedSample />

    <section class="grid lg:grid-cols-3 gap-5">
      <article class="rounded-2xl border border-slate-800 bg-slate-900/50 p-6">
        <p class="text-xs font-semibold uppercase tracking-widest text-slate-500 mb-3">Radar Base</p>
        <h2 class="text-xl font-bold text-slate-100 mb-2">Desde 149 €/mes</h2>
        <p class="text-sm text-slate-400 mb-4">Seguimiento operativo básico según cobertura y frecuencia.</p>
        <ul class="space-y-2 text-sm text-slate-300">
          <li>Cobertura operativa inicial</li>
          <li>CSV o Excel semanal</li>
          <li>Sector y ámbito</li>
          <li>Enlace oficial</li>
        </ul>
      </article>
      <article class="rounded-2xl border border-emerald-700/40 bg-emerald-950/20 p-6">
        <p class="text-xs font-semibold uppercase tracking-widest text-emerald-400 mb-3">Radar Pro</p>
        <h2 class="text-xl font-bold text-slate-100 mb-2">Según cobertura</h2>
        <p class="text-sm text-slate-400 mb-4">La opción recomendada para despachos con cartera activa, varios sectores o seguimiento recurrente.</p>
        <ul class="space-y-2 text-sm text-slate-300">
          <li>Todo lo de Base</li>
          <li>Prioridad comercial</li>
          <li>Shortlist accionable</li>
          <li>Alertas urgentes</li>
        </ul>
      </article>
      <article class="rounded-2xl border border-slate-800 bg-slate-900/50 p-6">
        <p class="text-xs font-semibold uppercase tracking-widest text-slate-500 mb-3">Radar Premium</p>
        <h2 class="text-xl font-bold text-slate-100 mb-2">A medida</h2>
        <p class="text-sm text-slate-400 mb-4">Cobertura adaptada a comunidad, sector, cartera concreta o necesidad puntual.</p>
        <ul class="space-y-2 text-sm text-slate-300">
          <li>Segmentación a medida</li>
          <li>Enfoque por vertical</li>
          <li>Mayor frecuencia</li>
          <li>Acuerdo directo</li>
        </ul>
      </article>
    </section>

    <section id="contacto" class="grid lg:grid-cols-[1.1fr_0.9fr] gap-6">
      <div class="rounded-2xl border border-emerald-900/40 bg-gradient-to-br from-emerald-950/25 to-slate-950 p-6">
        <p class="text-xs font-semibold uppercase tracking-widest text-emerald-400 mb-3">Qué pedir por email</p>
        <h2 class="text-2xl font-bold text-slate-100 mb-3">Contacto directo para muestra, filtrados o seguimiento</h2>
        <p class="text-sm text-slate-400 mb-6">Puedes escribir directamente para pedir una muestra en CSV/Excel, consultar un filtrado puntual o valorar una cobertura recurrente según tu cartera.</p>
        <div class="space-y-3">
          <a href="mailto:josue@benchdatalab.com?subject=Solicitud%20Radar%20Subvenciones" class="flex items-center justify-between rounded-xl border border-slate-800 bg-slate-950/70 px-4 py-4 text-sm text-slate-200 hover:border-emerald-700/60 hover:text-white transition-colors">
            <span>Escribir para pedir muestra</span>
            <span class="text-emerald-400">josue@benchdatalab.com</span>
          </a>
          <a href="mailto:josue@benchdatalab.com?subject=Filtrado%20puntual%20Radar%20Subvenciones" class="flex items-center justify-between rounded-xl border border-slate-800 bg-slate-950/70 px-4 py-4 text-sm text-slate-200 hover:border-emerald-700/60 hover:text-white transition-colors">
            <span>Solicitar filtrado puntual</span>
            <span class="text-slate-500">campaña, sector o comunidad</span>
          </a>
          <a href="mailto:josue@benchdatalab.com?subject=Seguimiento%20recurrente%20Radar%20Subvenciones" class="flex items-center justify-between rounded-xl border border-slate-800 bg-slate-950/70 px-4 py-4 text-sm text-slate-200 hover:border-emerald-700/60 hover:text-white transition-colors">
            <span>Consultar seguimiento recurrente</span>
            <span class="text-slate-500">despachos con cartera activa</span>
          </a>
        </div>
      </div>

      <div class="rounded-2xl border border-slate-800 bg-slate-900/60 p-6">
        <p class="text-xs font-semibold uppercase tracking-widest text-slate-500 mb-3">Qué pasa después</p>
        <div class="space-y-3 text-sm text-slate-300">
          <div class="rounded-xl border border-slate-800 bg-slate-950/70 p-4">
            <p class="font-semibold text-slate-100">1. Revisamos tu caso</p>
            <p class="text-slate-400 mt-1">Vemos si tu despacho trabaja con pymes, autónomos, empresas o verticales concretas.</p>
          </div>
          <div class="rounded-xl border border-slate-800 bg-slate-950/70 p-4">
            <p class="font-semibold text-slate-100">2. Enviamos muestra</p>
            <p class="text-slate-400 mt-1">Recibes una muestra del CSV/Excel con campos reales: prioridad, motivo, sector, ámbito y enlace oficial.</p>
          </div>
          <div class="rounded-xl border border-slate-800 bg-slate-950/70 p-4">
            <p class="font-semibold text-slate-100">3. Ajustamos cobertura</p>
            <p class="text-slate-400 mt-1">Si tiene sentido, definimos frecuencia, comunidades y sectores útiles para tu cartera.</p>
          </div>
          <div class="rounded-xl border border-slate-800 bg-slate-950/70 p-4">
            <p class="font-semibold text-slate-100">Contacto directo</p>
            <p class="text-slate-400 mt-1"><a href="mailto:josue@benchdatalab.com" class="text-emerald-400 hover:underline">josue@benchdatalab.com</a></p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="border-t border-slate-800/60 mt-10">
    <div class="max-w-5xl mx-auto px-4 py-8 grid md:grid-cols-[1.1fr_0.9fr] gap-6 text-xs text-slate-500">
      <div>
        <p class="text-slate-200 font-semibold">Radar Subvenciones</p>
        <p class="mt-1">Un producto de BenchDataLab</p>
        <p class="mt-1">laboratorio independiente de datos</p>
        <p class="mt-3">
          Contacto:
          <a href="mailto:josue@benchdatalab.com" class="text-emerald-400 hover:underline">josue@benchdatalab.com</a>
        </p>
      </div>
      <nav class="flex flex-wrap content-start gap-x-4 gap-y-2 justify-start md:justify-end">
        <a href="/" class="hover:text-slate-300 transition-colors">Inicio</a>
        <a href="/asesorias" class="hover:text-slate-300 transition-colors">Asesorías</a>
        <a href="/quienes-somos" class="hover:text-slate-300 transition-colors">Quiénes somos</a>
        <a href="https://benchdatalab.com" class="hover:text-slate-300 transition-colors" target="_blank" rel="noreferrer">BenchDataLab</a>
      </nav>
    </div>
  </footer>
</Layout>
