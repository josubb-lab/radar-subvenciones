---
import Layout from '../layouts/Layout.astro'
import NavBar from '../components/NavBar.astro'
import { SITE } from '../lib/config'
import B2BFeedSample from '../components/B2BFeedSample.astro'

const pageTitle = 'Feed de Subvenciones para Asesorías · Radar Subvenciones'
const pageDesc = 'Feed CSV o Excel de subvenciones filtradas para asesorías, gestorías y consultoras: convocatorias priorizadas y listas para accionar.'

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: 'Feed de subvenciones para asesorías',
      provider: { '@type': 'Organization', name: SITE.nombre, url: SITE.siteUrl },
      areaServed: { '@type': 'Country', name: 'Spain' },
      description: pageDesc,
      serviceType: 'Feed comercial de subvenciones y seguimiento para despachos',
      url: `${SITE.siteUrl}/asesorias`,
    },
  ],
}
---

<Layout title={pageTitle} description={pageDesc} jsonLd={jsonLd} showAds={false}>
  <NavBar breadcrumb={[{ label: 'Asesorías' }]} />

  <main class="max-w-5xl mx-auto px-4 py-10 space-y-10">

    <!-- Hero: sobrio, sin gradient, diferente de index -->
    <section class="border-b border-slate-800 pb-10">
      <p class="text-xs font-semibold uppercase tracking-widest text-emerald-500 mb-3">Para despachos profesionales</p>
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-slate-50 leading-tight mb-4">
        Seguimiento de subvenciones<br class="hidden sm:block"> para asesorías y gestorías
      </h1>
      <p class="text-slate-400 max-w-2xl mb-6">
        Filtramos convocatorias públicas y las entregamos en CSV o Excel, clasificadas por relevancia para tu cartera. Sin revisar boletines ni perder tiempo en publicaciones irrelevantes.
      </p>
      <a href="#contacto" class="inline-flex items-center justify-center px-5 py-3 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 text-sm font-bold transition-colors">
        Pedir muestra por email
      </a>
    </section>

    <!-- El entregable: qué recibe exactamente la asesoría -->
    <section class="rounded-2xl border border-slate-800 bg-slate-900/50 p-6">
      <h2 class="text-lg font-bold text-slate-100 mb-3">Qué recibe tu despacho</h2>
      <p class="text-sm text-slate-400 mb-5">Un CSV o Excel con las convocatorias filtradas, listo para revisar con tu equipo o compartir con el cliente. Cada registro incluye:</p>
      <dl class="grid sm:grid-cols-2 gap-x-10 gap-y-3 text-sm">
        <div class="flex gap-3 items-start">
          <dt class="flex items-center gap-1.5 text-slate-500 shrink-0 w-36">
            <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/></svg>
            Título
          </dt>
          <dd class="text-slate-300">Nombre oficial de la convocatoria</dd>
        </div>
        <div class="flex gap-3 items-start">
          <dt class="flex items-center gap-1.5 text-slate-500 shrink-0 w-36">
            <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 21h16.5M4.5 3h15M5.25 3v18m13.5-18v18M9 6.75h1.5m-1.5 3h1.5m-1.5 3h1.5m3-6H15m-1.5 3H15m-1.5 3H15M9 21v-3.375c0-.621.504-1.125 1.125-1.125h3.75c.621 0 1.125.504 1.125 1.125V21"/></svg>
            Organismo
          </dt>
          <dd class="text-slate-300">Administración o entidad convocante</dd>
        </div>
        <div class="flex gap-3 items-start">
          <dt class="flex items-center gap-1.5 text-slate-500 shrink-0 w-36">
            <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/></svg>
            Destinatarios
          </dt>
          <dd class="text-slate-300">Pyme, autónomo, empresa, entidad…</dd>
        </div>
        <div class="flex gap-3 items-start">
          <dt class="flex items-center gap-1.5 text-slate-500 shrink-0 w-36">
            <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/></svg>
            Territorio
          </dt>
          <dd class="text-slate-300">Nacional, comunidad autónoma, provincial</dd>
        </div>
        <div class="flex gap-3 items-start">
          <dt class="flex items-center gap-1.5 text-slate-500 shrink-0 w-36">
            <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 013 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 00-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 01-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 003 15h-.75M15 10.5a3 3 0 11-6 0 3 3 0 016 0zm3 0h.008v.008H18V10.5zm-12 0h.008v.008H6V10.5z"/></svg>
            Importe máximo
          </dt>
          <dd class="text-slate-300">Cuantía máxima de la ayuda</dd>
        </div>
        <div class="flex gap-3 items-start">
          <dt class="flex items-center gap-1.5 text-slate-500 shrink-0 w-36">
            <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 9v7.5"/></svg>
            Fecha límite
          </dt>
          <dd class="text-slate-300">Plazo de solicitud</dd>
        </div>
        <div class="flex gap-3 items-start">
          <dt class="flex items-center gap-1.5 text-slate-500 shrink-0 w-36">
            <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z"/></svg>
            Prioridad
          </dt>
          <dd class="text-slate-300">Alta, media o baja según encaje</dd>
        </div>
        <div class="flex gap-3 items-start">
          <dt class="flex items-center gap-1.5 text-slate-500 shrink-0 w-36">
            <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 18v-5.25m0 0a6.01 6.01 0 001.5-.189m-1.5.189a6.01 6.01 0 01-1.5-.189m3.75 7.478a12.06 12.06 0 01-4.5 0m3.75 2.383a14.406 14.406 0 01-3 0M14.25 18v-.192c0-.983.658-1.823 1.508-2.316a7.5 7.5 0 10-7.517 0c.85.493 1.509 1.333 1.509 2.316V18"/></svg>
            Motivo de prioridad
          </dt>
          <dd class="text-slate-300">Por qué es relevante para la cartera</dd>
        </div>
        <div class="flex gap-3 items-start">
          <dt class="flex items-center gap-1.5 text-slate-500 shrink-0 w-36">
            <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"/></svg>
            Enlace oficial
          </dt>
          <dd class="text-slate-300">Acceso directo a la convocatoria</dd>
        </div>
      </dl>
    </section>

    <!-- Tipos de cobertura: expandidos, con icono -->
    <section id="como-funciona" class="rounded-2xl border border-slate-800 bg-slate-900/50 p-6">
      <h2 class="text-lg font-bold text-slate-100 mb-5">Tipos de cobertura</h2>
      <div class="divide-y divide-slate-800">
        <div class="pb-5 flex gap-4">
          <svg class="w-4 h-4 text-slate-500 mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 9.776c.112-.017.227-.026.344-.026h15.812c.117 0 .232.009.344.026m-16.5 0a2.25 2.25 0 00-1.883 2.542l.857 6a2.25 2.25 0 002.227 1.932H19.05a2.25 2.25 0 002.227-1.932l.857-6a2.25 2.25 0 00-1.883-2.542m-16.5 0V6A2.25 2.25 0 016 3.75h3.879a1.5 1.5 0 011.06.44l2.122 2.12a1.5 1.5 0 001.06.44H18A2.25 2.25 0 0120.25 9v.776"/>
          </svg>
          <div>
            <p class="font-semibold text-slate-100 mb-2">Filtrado puntual</p>
            <p class="text-sm text-slate-400 mb-2">Para cuando un cliente pregunta por ayudas concretas o necesitas revisar oportunidades para una campaña. Lo solicitas una vez y recibes una lista clasificada para ese caso, sin compromiso de continuidad.</p>
            <p class="text-xs text-slate-500">Ej.: cliente de hostelería pregunta por digitalización → filtrado por sector y comunidad → lista priorizada en 48 horas.</p>
          </div>
        </div>
        <div class="py-5 flex gap-4">
          <svg class="w-4 h-4 text-emerald-600 mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99"/>
          </svg>
          <div>
            <p class="font-semibold text-slate-100 mb-2">Seguimiento recurrente</p>
            <p class="text-sm text-slate-400 mb-2">Para despachos con cartera activa que quieren estar al día sin revisión manual. Recibes el feed cada semana o quincena, con las nuevas convocatorias ordenadas por prioridad.</p>
            <p class="text-xs text-slate-500">Ej.: cartera de pymes industriales → feed semanal → el equipo revisa y activa con los clientes correspondientes.</p>
          </div>
        </div>
        <div class="pt-5 flex gap-4">
          <svg class="w-4 h-4 text-slate-500 mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.325.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 011.37.49l1.296 2.247a1.125 1.125 0 01-.26 1.431l-1.003.827c-.293.241-.438.613-.43.992a7.723 7.723 0 010 .255c-.008.378.137.75.43.991l1.004.827c.424.35.534.955.26 1.43l-1.298 2.247a1.125 1.125 0 01-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.47 6.47 0 01-.22.128c-.331.183-.581.495-.644.869l-.213 1.281c-.09.543-.56.94-1.11.94h-2.594c-.55 0-1.019-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 01-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 01-1.369-.49l-1.297-2.247a1.125 1.125 0 01.26-1.431l1.004-.827c.292-.24.437-.613.43-.991a6.932 6.932 0 010-.255c.007-.38-.138-.751-.43-.992l-1.004-.827a1.125 1.125 0 01-.26-1.43l1.297-2.247a1.125 1.125 0 011.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.086.22-.128.332-.183.582-.495.644-.869l.214-1.28z"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
          <div>
            <p class="font-semibold text-slate-100 mb-2">Cobertura personalizada</p>
            <p class="text-sm text-slate-400">Si tu cartera se concentra en un sector, territorio o tipo de cliente concreto, ajustamos el filtrado a ese perfil. Por acuerdo directo, sin estructura fija.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Planes: antes de la muestra -->
    <section>
      <h2 class="text-xl font-bold text-slate-100 mb-5">Planes y cobertura</h2>
      <div class="grid lg:grid-cols-3 gap-5">
        <article class="rounded-2xl border border-slate-800 bg-slate-900/50 p-6">
          <svg class="w-4 h-4 text-slate-600 mb-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/>
          </svg>
          <p class="text-xs font-semibold uppercase tracking-widest text-slate-500 mb-3">Radar Base</p>
          <p class="text-xl font-bold text-slate-100 mb-2">Desde 149 €/mes</p>
          <p class="text-sm text-slate-400 mb-4">Seguimiento operativo básico según cobertura y frecuencia.</p>
          <ul class="space-y-2 text-sm text-slate-300">
            <li>Cobertura operativa inicial</li>
            <li>CSV o Excel semanal</li>
            <li>Sector y ámbito</li>
            <li>Enlace oficial</li>
          </ul>
        </article>
        <article class="rounded-2xl border border-emerald-700/40 bg-emerald-950/20 p-6">
          <svg class="w-4 h-4 text-emerald-600 mb-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z"/>
          </svg>
          <p class="text-xs font-semibold uppercase tracking-widest text-emerald-400 mb-3">Radar Pro</p>
          <p class="text-xl font-bold text-slate-100 mb-2">Según cobertura</p>
          <p class="text-sm text-slate-400 mb-4">Para despachos con cartera activa, varios sectores o seguimiento recurrente.</p>
          <ul class="space-y-2 text-sm text-slate-300">
            <li>Todo lo de Base</li>
            <li>Prioridad por oportunidad</li>
            <li>Lista reducida accionable</li>
            <li>Alertas urgentes</li>
          </ul>
        </article>
        <article class="rounded-2xl border border-slate-800 bg-slate-900/50 p-6">
          <svg class="w-4 h-4 text-slate-600 mb-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6h9.75M10.5 6a1.5 1.5 0 11-3 0m3 0a1.5 1.5 0 10-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-9.75 0h9.75"/>
          </svg>
          <p class="text-xs font-semibold uppercase tracking-widest text-slate-500 mb-3">Radar Premium</p>
          <p class="text-xl font-bold text-slate-100 mb-2">A medida</p>
          <p class="text-sm text-slate-400 mb-4">Cobertura adaptada a comunidad, sector, cartera concreta o necesidad puntual.</p>
          <ul class="space-y-2 text-sm text-slate-300">
            <li>Segmentación a medida</li>
            <li>Enfoque por vertical</li>
            <li>Mayor frecuencia</li>
            <li>Acuerdo directo</li>
          </ul>
        </article>
      </div>
    </section>

    <!-- Muestra del feed: inline, diferente de index -->
    <section class="rounded-2xl border border-slate-800 bg-slate-900/40 p-6">
      <p class="text-xs font-semibold uppercase tracking-widest text-emerald-400 mb-2">Ejemplo de entregable</p>
      <h2 class="text-lg font-bold text-slate-100 mb-5">Así llegan las oportunidades</h2>
      <div class="space-y-3">
        <div class="rounded-xl border border-slate-800 bg-slate-950/60 px-4 py-3 text-sm space-y-1.5">
          <div class="flex items-start gap-2 flex-wrap">
            <span class="inline-flex items-center text-[11px] font-semibold px-2 py-0.5 rounded-full ring-1 text-emerald-400 bg-emerald-950/60 ring-emerald-700/50 shrink-0">Alta</span>
            <span class="text-slate-200 font-medium">Ayudas a la digitalización de pymes (IVACE Energía)</span>
          </div>
          <p class="text-xs text-slate-500">IVACE · Comunidad Valenciana · Pymes y micropymes · Hasta 50.000 € · Límite: 30/09/2026</p>
          <p class="text-xs text-slate-600">Múltiples convocatorias activas para inversión en software y equipamiento tecnológico en la región.</p>
        </div>
        <div class="rounded-xl border border-slate-800 bg-slate-950/60 px-4 py-3 text-sm space-y-1.5">
          <div class="flex items-start gap-2 flex-wrap">
            <span class="inline-flex items-center text-[11px] font-semibold px-2 py-0.5 rounded-full ring-1 text-emerald-400 bg-emerald-950/60 ring-emerald-700/50 shrink-0">Alta</span>
            <span class="text-slate-200 font-medium">Programa de fomento del empleo autónomo</span>
          </div>
          <p class="text-xs text-slate-500">SEPA Asturias · Asturias · Autónomos y trabajadores por cuenta propia · Hasta 10.000 € · Límite: 31/07/2026</p>
          <p class="text-xs text-slate-600">Incentivos a la capitalización y alta como autónomo, especialmente para menores de 35 años o desempleados de larga duración.</p>
        </div>
        <div class="rounded-xl border border-slate-800 bg-slate-950/60 px-4 py-3 text-sm space-y-1.5">
          <div class="flex items-start gap-2 flex-wrap">
            <span class="inline-flex items-center text-[11px] font-semibold px-2 py-0.5 rounded-full ring-1 text-amber-400 bg-amber-950/60 ring-amber-700/50 shrink-0">Media</span>
            <span class="text-slate-200 font-medium">Subvenciones a la contratación de jóvenes desempleados</span>
          </div>
          <p class="text-xs text-slate-500">LABORA · Comunidad Valenciana · Empresas de cualquier tamaño · Hasta 6.000 € por contrato · Límite: 15/06/2026</p>
          <p class="text-xs text-slate-600">Relevante para despachos con cartera en sectores intensivos en mano de obra como hostelería, retail o logística.</p>
        </div>
        <div class="rounded-xl border border-slate-800 bg-slate-950/60 px-4 py-3 text-sm space-y-1.5">
          <div class="flex items-start gap-2 flex-wrap">
            <span class="inline-flex items-center text-[11px] font-semibold px-2 py-0.5 rounded-full ring-1 text-emerald-400 bg-emerald-950/60 ring-emerald-700/50 shrink-0">Alta</span>
            <span class="text-slate-200 font-medium">Concurso de empresas de base tecnológica — Madrid Emprende</span>
          </div>
          <p class="text-xs text-slate-500">Comunidad de Madrid · Madrid · Empresas tecnológicas y startups · Hasta 75.000 € · Límite: 28/02/2027</p>
          <p class="text-xs text-slate-600">Alta puntuación por importe y cobertura amplia; adecuado para despachos con clientes en el clúster tecnológico de la región.</p>
        </div>
      </div>
      <p class="text-xs text-slate-600 mt-4">Datos ilustrativos. El entregable real refleja convocatorias vigentes en el momento del envío.</p>
    </section>

    <section id="contacto" class="rounded-2xl border border-emerald-900/50 bg-gradient-to-br from-emerald-950/30 to-slate-950 p-8 lg:p-12 text-center">
