---
export const prerender = true
import Layout from '../layouts/Layout.astro'
import { SECTORES } from '../lib/taxonomia'
---

<Layout
  title="Todos los sectores · Radar Subvenciones"
  description="Subvenciones y ayudas públicas por sector de actividad: autónomos, empresas, cultura, empleo, tecnología y más."
>
  <nav class="border-b border-slate-800 bg-slate-950/90 backdrop-blur sticky top-0 z-40">
    <div class="max-w-5xl mx-auto px-4 h-14 flex items-center justify-between">
      <div class="flex items-center gap-2 text-sm">
        <a href="/" class="font-bold text-slate-100 hover:text-emerald-400 transition-colors">
          <span class="text-emerald-400">◈</span> Radar Subvenciones
        </a>
        <span class="text-slate-700">/</span>
        <span class="text-slate-500">Sectores</span>
      </div>
      <div class="hidden sm:flex items-center gap-5 text-sm text-slate-400">
        <a href="/sector/autonomos"  class="hover:text-slate-100 transition-colors">Autónomos</a>
        <a href="/sector/empresas"   class="hover:text-slate-100 transition-colors">Empresas</a>
        <a href="/sector/empleo"     class="hover:text-slate-100 transition-colors">Empleo</a>
        <a href="/guias"             class="hover:text-slate-100 transition-colors">Guías</a>
      </div>
    </div>
  </nav>

  <main class="max-w-5xl mx-auto px-4 py-12">
    <h1 class="text-2xl font-extrabold text-slate-50 mb-8">Subvenciones por sector</h1>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {SECTORES.map(s => (
        <a
          href={`/sector/${s.slug}`}
          class="rounded-xl border border-slate-800 bg-slate-900/50 p-5 hover:border-emerald-700 hover:bg-emerald-950/20 transition-colors group"
        >
          <h2 class="text-sm font-semibold text-slate-200 group-hover:text-emerald-400 transition-colors">
            {s.nombre}
          </h2>
          <p class="text-xs text-slate-500 mt-1">Ver convocatorias →</p>
        </a>
      ))}
    </div>
  </main>
</Layout>
