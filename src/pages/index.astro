---
import Layout from '../layouts/Layout.astro'
import { SITE } from '../lib/config'
import NavBar from '../components/NavBar.astro'
import B2BFeedSample from '../components/B2BFeedSample.astro'

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      name: SITE.nombre,
      description: SITE.desc,
      url: SITE.siteUrl,
      inLanguage: 'es',
      potentialAction: {
        '@type': 'SearchAction',
        target: { '@type': 'EntryPoint', urlTemplate: `${SITE.siteUrl}/sector/{search_term_string}` },
        'query-input': 'required name=search_term_string',
      },
    },
    {
      '@type': 'Service',
      name: 'Feed de subvenciones para asesorías',
      description: 'Servicio de seguimiento y filtrado de subvenciones para asesorías, gestorías y despachos profesionales.',
      provider: { '@type': 'Organization', name: SITE.nombre, url: SITE.siteUrl },
      areaServed: { '@type': 'Country', name: 'Spain' },
      serviceType: 'Feed comercial de subvenciones',
      url: `${SITE.siteUrl}/asesorias`,
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: '¿Qué entrega Radar Subvenciones?',
          acceptedAnswer: { '@type': 'Answer', text: 'Entregamos un CSV o Excel con oportunidades filtradas para asesorías y gestorías, incluyendo prioridad, beneficiario, ámbito y enlace oficial.' },
        },
        {
          '@type': 'Question',
          name: '¿Para quién está pensado el producto?',
          acceptedAnswer: { '@type': 'Answer', text: 'Está pensado para asesorías, gestorías, despachos y profesionales que necesitan detectar ayudas relevantes para su cartera sin perder tiempo revisando publicaciones una a una.' },
        },
        {
          '@type': 'Question',
          name: '¿Se puede contratar de forma puntual o recurrente?',
          acceptedAnswer: { '@type': 'Answer', text: 'Sí. Hay filtrados puntuales, seguimiento recurrente y cobertura personalizada según cartera, sector o comunidad.' },
        },
        {
          '@type': 'Question',
          name: '¿Cómo se solicita una muestra?',
          acceptedAnswer: { '@type': 'Answer', text: 'Puedes dejar tus datos en la web y recibir una muestra de Radar Subvenciones para valorar si encaja con tu despacho.' },
        },
      ],
    },
  ],
}
---

<Layout jsonLd={jsonLd}>

  <NavBar />

  <section class="bg-gradient-to-b from-emerald-950/30 to-slate-950 border-b border-slate-800/60">
    <div class="max-w-5xl mx-auto px-4 py-14 lg:py-20">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-slate-50 leading-tight mb-4">
        Feed comercial de subvenciones<br class="hidden sm:block"> para asesorías y gestorías
      </h1>
      <p class="text-slate-400 text-lg max-w-3xl mb-8">
        Radar Subvenciones ayuda a despachos y profesionales a seguir ayudas relevantes con datos filtrados, monitorización continua y entregables CSV o Excel listos para trabajar.
      </p>

      <div class="flex flex-wrap gap-3 mb-8">
        <a
          href="/asesorias"
          class="inline-flex items-center justify-center px-5 py-3 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 text-sm font-bold transition-colors"
        >
          Pedir muestra del feed
        </a>
        <a
          href="/asesorias#como-funciona"
          class="inline-flex items-center justify-center px-5 py-3 rounded-xl border border-slate-700 hover:border-emerald-600 text-slate-200 text-sm font-semibold transition-colors"
        >
          Ver cómo funciona
        </a>
      </div>

      <div class="grid md:grid-cols-3 gap-4">
        <div class="rounded-2xl border border-slate-800 bg-slate-900/50 p-4">
          <p class="text-xs font-semibold uppercase tracking-widest text-slate-500 mb-2">Ahorro de tiempo</p>
          <p class="text-sm text-slate-300">Menos horas revisando publicaciones y más foco en mover oportunidades útiles para tus clientes.</p>
        </div>
        <div class="rounded-2xl border border-slate-800 bg-slate-900/50 p-4">
          <p class="text-xs font-semibold uppercase tracking-widest text-slate-500 mb-2">Oportunidades filtradas</p>
          <p class="text-sm text-slate-300">CSV o Excel con prioridad, ámbito, beneficiario, señal comercial y enlace oficial.</p>
        </div>
        <div class="rounded-2xl border border-slate-800 bg-slate-900/50 p-4">
          <p class="text-xs font-semibold uppercase tracking-widest text-slate-500 mb-2">Seguimiento profesional</p>
          <p class="text-sm text-slate-300">Monitorización, filtrado y cobertura adaptable para asesorías, gestorías y despachos.</p>
        </div>
      </div>
    </div>
  </section>

  <main class="max-w-5xl mx-auto px-4 py-10 space-y-10">
    <section id="como-funciona" class="rounded-2xl border border-slate-800 bg-slate-900/50 p-6">
      <h2 class="text-xl font-bold text-slate-100 mb-4">Cómo funciona</h2>
      <div class="grid md:grid-cols-4 gap-4 text-sm text-slate-300">
        <div>
          <p class="text-emerald-400 font-semibold mb-1">1. Seguimiento</p>
          <p>Seguimos ayudas relevantes para que tu despacho no dependa de revisar publicaciones una a una.</p>
        </div>
        <div>
          <p class="text-emerald-400 font-semibold mb-1">2. Filtrado</p>
          <p>Quitamos ruido y priorizamos oportunidades con valor para pymes, autónomos, empresas y empleo.</p>
        </div>
        <div>
          <p class="text-emerald-400 font-semibold mb-1">3. Entrega</p>
          <p>Recibes un CSV o Excel claro, preparado para compartir, revisar o activar con tu cartera.</p>
        </div>
        <div>
          <p class="text-emerald-400 font-semibold mb-1">4. Acción</p>
          <p>Tu equipo decide qué mover antes y con qué cobertura: puntual, recurrente o personalizada.</p>
        </div>
      </div>
    </section>

    <section class="grid md:grid-cols-3 gap-5">
      <article class="rounded-2xl border border-slate-800 bg-slate-900/50 p-6">
        <p class="text-xs font-semibold uppercase tracking-widest text-slate-500 mb-3">Filtrado puntual</p>
        <p class="text-sm text-slate-300">Selecciones concretas para una campaña, un cliente relevante o una necesidad inmediata.</p>
      </article>
      <article class="rounded-2xl border border-emerald-800/40 bg-emerald-950/20 p-6">
        <p class="text-xs font-semibold uppercase tracking-widest text-emerald-400 mb-3">Seguimiento recurrente</p>
        <p class="text-sm text-slate-300">Cobertura periódica para despachos que necesitan detectar oportunidades de forma continua.</p>
      </article>
      <article class="rounded-2xl border border-slate-800 bg-slate-900/50 p-6">
        <p class="text-xs font-semibold uppercase tracking-widest text-slate-500 mb-3">Cobertura personalizada</p>
        <p class="text-sm text-slate-300">Ajustes por tipo de cartera, comunidad, vertical o perfil de cliente.</p>
      </article>
    </section>

    <B2BFeedSample />

    <section class="rounded-2xl border border-slate-800 bg-slate-900/50 p-6">
      <h2 class="text-xl font-bold text-slate-100 mb-4">Preguntas frecuentes</h2>
      <div class="grid md:grid-cols-2 gap-4 text-sm">
        <div class="rounded-xl border border-slate-800 bg-slate-950/60 p-4">
          <p class="font-semibold text-slate-100 mb-2">¿Qué recibo exactamente?</p>
          <p class="text-slate-400">Un CSV o Excel con oportunidades filtradas, prioridad, beneficiario, ámbito y enlace oficial.</p>
        </div>
        <div class="rounded-xl border border-slate-800 bg-slate-950/60 p-4">
          <p class="font-semibold text-slate-100 mb-2">¿Es solo para gestorías grandes?</p>
          <p class="text-slate-400">No. Encaja tanto en despachos pequeños como en equipos con seguimiento recurrente de ayudas.</p>
        </div>
        <div class="rounded-xl border border-slate-800 bg-slate-950/60 p-4">
          <p class="font-semibold text-slate-100 mb-2">¿Se puede pedir algo puntual?</p>
          <p class="text-slate-400">Sí. Hay filtrados puntuales, seguimiento recurrente y cobertura personalizada.</p>
        </div>
        <div class="rounded-xl border border-slate-800 bg-slate-950/60 p-4">
          <p class="font-semibold text-slate-100 mb-2">¿Cómo solicito una muestra?</p>
          <p class="text-slate-400">Dejas tus datos y te enviamos una muestra para valorar encaje con tu despacho.</p>
        </div>
      </div>
    </section>

    <section id="contacto" class="rounded-2xl border border-slate-800 bg-slate-900/50 p-6 lg:p-7">
    <div class="rounded-2xl border border-slate-800 bg-slate-900/50 p-6 lg:p-7">
      <div class="grid lg:grid-cols-[0.9fr_1.1fr] gap-6 items-start">
        <div>
          <p class="text-xs font-semibold uppercase tracking-widest text-emerald-400 mb-3">Solicitud de muestra</p>
          <h2 class="text-2xl font-bold text-slate-100 mb-3">Pide una muestra de Radar Subvenciones</h2>
          <p class="text-sm text-slate-400">
            Si llevas pymes, autónomos o empresas, te enseñamos cómo llega la información operativa: oportunidades filtradas, prioridad, sector, ámbito y enlace oficial.
          </p>
          <p class="text-sm text-slate-500 mt-4">
            Contacto directo: <a href="mailto:josue@benchdatalab.com" class="text-emerald-400 hover:underline">josue@benchdatalab.com</a>
          </p>
        </div>
        <form id="lead-home-form" class="grid sm:grid-cols-2 gap-4">
          <input type="hidden" name="tipo_despacho" value="Lead desde home" />
          <input type="hidden" name="clientes" value="" />
          <label class="block sm:col-span-1">
            <span class="text-xs text-slate-400 mb-1 block">Nombre</span>
            <input name="nombre" required class="w-full rounded-xl border border-slate-700 bg-slate-950 px-4 py-3 text-sm text-slate-100 outline-none focus:border-emerald-500" />
          </label>
          <label class="block sm:col-span-1">
            <span class="text-xs text-slate-400 mb-1 block">Empresa</span>
            <input name="empresa" required class="w-full rounded-xl border border-slate-700 bg-slate-950 px-4 py-3 text-sm text-slate-100 outline-none focus:border-emerald-500" />
          </label>
          <label class="block sm:col-span-2">
            <span class="text-xs text-slate-400 mb-1 block">Email profesional</span>
            <input type="email" name="email" required class="w-full rounded-xl border border-slate-700 bg-slate-950 px-4 py-3 text-sm text-slate-100 outline-none focus:border-emerald-500" />
          </label>
          <label class="block sm:col-span-2">
            <span class="text-xs text-slate-400 mb-1 block">Interés principal</span>
            <select name="interes" class="w-full rounded-xl border border-slate-700 bg-slate-950 px-4 py-3 text-sm text-slate-100 outline-none focus:border-emerald-500">
              <option value="">No especificado</option>
              <option>Feed semanal</option>
              <option>Alertas urgentes</option>
              <option>Segmentación por sector</option>
              <option>Segmentación por comunidad</option>
            </select>
          </label>
          <div class="sm:col-span-2 flex flex-wrap items-center gap-3">
            <button type="submit" class="inline-flex items-center justify-center px-5 py-3 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 text-sm font-bold transition-colors">
              Pedir muestra del feed
            </button>
            <p id="lead-home-status" class="text-sm text-slate-400"></p>
          </div>
          <p class="sm:col-span-2 text-xs text-slate-500">Usaremos tus datos solo para responder y enviarte una muestra de Radar Subvenciones. Contacto profesional: josue@benchdatalab.com.</p>
        </form>
      </div>
    </div>
  </section>
  </main>

  <!-- FOOTER -->
  <footer class="border-t border-slate-800/60 mt-10">
    <div class="max-w-5xl mx-auto px-4 py-8 flex flex-col sm:flex-row justify-between items-center gap-4 text-xs text-slate-600">
      <p>© {new Date().getFullYear()} Radar Subvenciones · Un producto de BenchDataLab</p>
      <nav class="flex flex-wrap gap-x-4 gap-y-1 justify-center">
        <a href="https://benchdatalab.com" class="hover:text-slate-400 transition-colors" target="_blank" rel="noreferrer">BenchDataLab</a>
        <a href="/origen-datos"        class="hover:text-slate-400 transition-colors">Fuentes</a>
        <a href="/aviso-legal"         class="hover:text-slate-400 transition-colors">Aviso legal</a>
        <a href="/politica-privacidad" class="hover:text-slate-400 transition-colors">Privacidad</a>
        <a href="/politica-cookies"    class="hover:text-slate-400 transition-colors">Cookies</a>
      </nav>
    </div>
  </footer>

  <script>
    async function bindLeadForm(formId, statusId) {
      const form = document.getElementById(formId);
      const status = document.getElementById(statusId);
      if (!(form instanceof HTMLFormElement) || !(status instanceof HTMLElement)) return;

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        status.textContent = 'Enviando...';
        status.className = 'text-sm text-slate-400';

        const formData = new FormData(form);
        const payload = Object.fromEntries(formData.entries());

        try {
          const res = await fetch('/api/lead-asesoria', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          const data = await res.json().catch(() => ({}));
          if (!res.ok) throw new Error(data.error || 'No se pudo enviar');
          if (data.ok !== true) throw new Error('Respuesta inesperada del servidor');
          form.reset();
          if (data.fallback) {
            status.innerHTML = 'No hemos podido registrar el formulario automaticamente. Escribenos a <a href="mailto:josue@benchdatalab.com" class="text-emerald-400 underline">josue@benchdatalab.com</a> y te enviamos la muestra.';
            status.className = 'text-sm text-amber-300';
          } else {
            status.textContent = 'Recibido. Te contactaremos con una muestra del feed.';
            status.className = 'text-sm text-emerald-400';
          }
        } catch (error) {
          status.textContent = error instanceof Error ? error.message : 'Ha fallado el envío';
          status.className = 'text-sm text-rose-400';
        }
      });
    }

    bindLeadForm('lead-home-form', 'lead-home-status');
  </script>

</Layout>
