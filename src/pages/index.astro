---
export const prerender = true
import Layout from '../layouts/Layout.astro'
import { createClient } from '@supabase/supabase-js'
import { SITE } from '../lib/config'
import { SECTORES, CCAA } from '../lib/taxonomia'
import { subvencionSlug } from '../lib/slugify'
import NavBar from '../components/NavBar.astro'

const supabase = createClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.PUBLIC_SUPABASE_KEY,
)

const { data: subvenciones } = await supabase
  .from('subvenciones')
  .select('id, titulo, descripcion, fuente, tipo, fecha_pub, url')
  .order('fecha_pub', { ascending: false, nullsFirst: false })
  .limit(50)

const { count: totalBD } = await supabase
  .from('subvenciones')
  .select('*', { count: 'exact', head: true })

const total = subvenciones?.length ?? 0
const totalConvocatorias = totalBD ?? 0

const TIPO_META: Record<string, { label: string; color: string }> = {
  convocatoria: { label: 'Convocatoria',  color: 'text-emerald-400 bg-emerald-950/60 ring-emerald-700/50' },
  extracto:     { label: 'Extracto BOE',  color: 'text-sky-400 bg-sky-950/60 ring-sky-700/50' },
  bases:        { label: 'Bases',          color: 'text-amber-400 bg-amber-950/60 ring-amber-700/50' },
  resolucion:   { label: 'Resolución',    color: 'text-rose-400 bg-rose-950/60 ring-rose-700/50' },
}
function tipoMeta(tipo: string) {
  return TIPO_META[tipo] ?? { label: tipo ?? 'Ayuda', color: 'text-slate-400 bg-slate-800 ring-slate-700/50' }
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      name: SITE.nombre,
      description: SITE.desc,
      url: SITE.siteUrl,
      inLanguage: 'es',
      potentialAction: {
        '@type': 'SearchAction',
        target: { '@type': 'EntryPoint', urlTemplate: `${SITE.siteUrl}/sector/{search_term_string}` },
        'query-input': 'required name=search_term_string',
      },
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: '¿Qué es una subvención pública en España?',
          acceptedAnswer: { '@type': 'Answer', text: 'Una subvención pública es una ayuda económica concedida por organismos del Estado, comunidades autónomas o ayuntamientos a empresas, autónomos o particulares para financiar actividades de interés general, sin obligación de devolución.' },
        },
        {
          '@type': 'Question',
          name: '¿Dónde se publican las convocatorias de subvenciones en España?',
          acceptedAnswer: { '@type': 'Answer', text: 'Las subvenciones estatales se publican en el Boletín Oficial del Estado (BOE) y en la Base de Datos Nacional de Subvenciones (BDNS). Cada comunidad autónoma tiene además su propio boletín oficial. Radar Subvenciones agrega todas estas fuentes en un solo lugar.' },
        },
        {
          '@type': 'Question',
          name: '¿Qué es el BDNS?',
          acceptedAnswer: { '@type': 'Answer', text: 'El BDNS (Base de Datos Nacional de Subvenciones) es el registro oficial del Ministerio de Hacienda donde se publican todas las convocatorias de subvenciones y ayudas públicas en España.' },
        },
        {
          '@type': 'Question',
          name: '¿Quién puede solicitar subvenciones públicas en España?',
          acceptedAnswer: { '@type': 'Answer', text: 'Pueden solicitar subvenciones personas físicas (autónomos, particulares), personas jurídicas (empresas, pymes, asociaciones, ONG) y entidades públicas, dependiendo de los requisitos de cada convocatoria.' },
        },
        {
          '@type': 'Question',
          name: '¿Con qué frecuencia se actualiza Radar Subvenciones?',
          acceptedAnswer: { '@type': 'Answer', text: 'Radar Subvenciones se actualiza automáticamente cada día laborable extrayendo las nuevas convocatorias del BOE y el BDNS, por lo que siempre muestra las ayudas más recientes disponibles.' },
        },
      ],
    },
  ],
}
---

<Layout jsonLd={jsonLd}>

  <NavBar />

  <!-- HERO -->
  <section class="bg-gradient-to-b from-emerald-950/30 to-slate-950 border-b border-slate-800/60">
    <div class="max-w-5xl mx-auto px-4 py-14 lg:py-20">
      <p class="text-emerald-400 text-xs font-semibold uppercase tracking-widest mb-3">
        Actualizado diariamente desde BOE y BDNS
      </p>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-slate-50 leading-tight mb-4">
        Subvenciones y ayudas públicas<br class="hidden sm:block"> en España
      </h1>
      <p class="text-slate-400 text-lg max-w-2xl mb-8">
        Encuentra subvenciones y ayudas públicas para autónomos, empresas, cultura, I+D, energía y más.
        Todas las convocatorias del BOE y boletines autonómicos en un solo lugar.
      </p>

      <!-- ESTADÍSTICAS -->
      <div class="flex flex-wrap gap-6 mb-8">
        <div>
          <p class="text-2xl font-extrabold text-emerald-400">{totalConvocatorias.toLocaleString('es-ES')}+</p>
          <p class="text-xs text-slate-500 mt-0.5">convocatorias monitorizadas</p>
        </div>
        <div>
          <p class="text-2xl font-extrabold text-emerald-400">17</p>
          <p class="text-xs text-slate-500 mt-0.5">comunidades autónomas</p>
        </div>
        <div>
          <p class="text-2xl font-extrabold text-emerald-400">Diario</p>
          <p class="text-xs text-slate-500 mt-0.5">actualización automática</p>
        </div>
        <div>
          <p class="text-2xl font-extrabold text-emerald-400">Gratis</p>
          <p class="text-xs text-slate-500 mt-0.5">sin registro</p>
        </div>
      </div>

      <!-- BUSCADOR POR SECTOR -->
      <div class="flex flex-wrap gap-2">
        {SECTORES.slice(0, 8).map(s => (
          <a
            href={`/sector/${s.slug}`}
            class="px-3 py-1.5 rounded-full text-sm font-medium border border-slate-700 bg-slate-900 text-slate-300 hover:border-emerald-600 hover:text-emerald-400 transition-colors"
          >
            {s.nombre}
          </a>
        ))}
        <a
          href="/sectores"
          class="px-3 py-1.5 rounded-full text-sm font-medium border border-slate-700 bg-slate-900 text-slate-500 hover:text-slate-300 transition-colors"
        >
          Ver todos →
        </a>
      </div>
    </div>
  </section>

  <!-- BANNER TELEGRAM -->
  <section class="border-b border-slate-800/60 bg-slate-900/40">
    <div class="max-w-5xl mx-auto px-4 py-7">
      <div class="flex flex-col sm:flex-row sm:items-center gap-8">
        <div class="flex-1 max-w-lg">
          <p class="text-xs font-semibold text-emerald-400 uppercase tracking-widest mb-1">Bot de Telegram · Gratis</p>
          <h2 class="text-base font-bold text-slate-100 mb-2">Recibe alertas de subvenciones en Telegram</h2>
          <p class="text-sm text-slate-400">El bot rastrea el BOE y el BDNS cada día y envía las nuevas convocatorias automáticamente en Telegram.</p>
        </div>
        <form class="js-form-telegram flex gap-2 shrink-0 w-full sm:w-auto">
          <input
            type="email"
            name="email"
            placeholder="tu@email.com"
            required
            class="flex-1 sm:w-56 px-3 py-2 rounded-lg bg-slate-800 border border-slate-700 text-slate-100 placeholder-slate-500 text-sm focus:outline-none focus:border-emerald-600"
          />
          <button
            type="submit"
            class="px-4 py-2 rounded-lg bg-emerald-500 hover:bg-emerald-400 text-slate-950 text-sm font-bold transition-colors whitespace-nowrap"
          >
            Acceder →
          </button>
        </form>
      </div>
    </div>
  </section>

  <main class="max-w-5xl mx-auto px-4 py-10 grid lg:grid-cols-[1fr_300px] gap-10">

    <!-- LISTADO PRINCIPAL -->
    <section>
      <h2 class="text-sm font-semibold text-slate-400 uppercase tracking-widest mb-5">
        Últimas convocatorias
      </h2>

      {(subvenciones ?? []).length === 0 ? (
        <p class="text-slate-500 text-sm">El radar actualiza diariamente. Vuelve pronto.</p>
      ) : (
        <ol class="space-y-4">
          {(subvenciones ?? []).map(s => {
            const tm = tipoMeta(s.tipo)
            const slug = subvencionSlug(s.titulo ?? '', s.id)
            const fecha = s.fecha_pub
              ? new Date(s.fecha_pub).toLocaleDateString('es-ES', { day: '2-digit', month: 'short', year: 'numeric' })
              : null
            return (
              <li class="rounded-xl border border-slate-800 bg-slate-900/50 hover:border-emerald-800/60 hover:bg-slate-900 transition-colors overflow-hidden flex">
                <div class="w-1 bg-emerald-700/40 shrink-0 group-hover:bg-emerald-500"></div>
                <div class="p-5 flex-1 min-w-0">
                  <div class="flex flex-wrap items-center gap-2 mb-2">
                    <span class={`inline-flex items-center gap-1 text-[11px] font-semibold px-2 py-0.5 rounded-full ring-1 ${tm.color}`}>
                      {tm.label}
                    </span>
                    {fecha && <time class="text-xs text-slate-500 ml-auto">{fecha}</time>}
                  </div>

                  <a href={`/subvencion/${slug}`} class="block text-base font-semibold text-slate-100 leading-snug mb-2 hover:text-emerald-400 transition-colors">
                    {s.titulo}
                  </a>

                  {s.descripcion && (
                    <p class="text-xs text-slate-500 leading-relaxed line-clamp-2">
                      {s.descripcion.slice(0, 200)}
                    </p>
                  )}
                </div>
              </li>
            )
          })}
        </ol>
      )}
    </section>

    <!-- SIDEBAR -->
    <aside class="space-y-6">

      <!-- POR CCAA -->
      <div class="rounded-xl border border-slate-800 bg-slate-900/50 p-5">
        <h3 class="text-xs font-semibold text-slate-400 uppercase tracking-widest mb-4">Por comunidad autónoma</h3>
        <ul class="space-y-1">
          {CCAA.map(c => (
            <li>
              <a href={`/ccaa/${c.slug}`} class="text-sm text-slate-400 hover:text-emerald-400 transition-colors block py-0.5">
                {c.nombre}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- ALERTA TELEGRAM -->
      <div class="rounded-xl border-2 border-emerald-700/60 bg-emerald-950/40 p-5">
        <p class="text-xs font-semibold text-emerald-400 uppercase tracking-widest mb-2">Bot de Telegram · Gratis</p>
        <h3 class="text-base font-bold text-emerald-200 mb-2">
          Alertas de subvenciones en Telegram
        </h3>
        <p class="text-xs text-slate-400 mb-4">
          El bot rastrea el BOE y el BDNS cada día y te envía las nuevas convocatorias directamente en Telegram.
        </p>
        <form class="js-form-telegram space-y-2">
          <input
            type="email"
            name="email"
            placeholder="tu@email.com"
            required
            class="w-full px-3 py-2 rounded-lg bg-slate-800 border border-slate-700 text-slate-100 placeholder-slate-500 text-sm focus:outline-none focus:border-emerald-600"
          />
          <button
            type="submit"
            class="w-full px-4 py-2.5 rounded-lg bg-emerald-500 hover:bg-emerald-400 text-slate-950 text-sm font-bold transition-colors"
          >
            Acceder al bot gratis
          </button>
        </form>
        <p class="js-form-msg text-xs mt-2 text-rose-400 hidden"></p>
      </div>

      <!-- CTA GESTOR -->
      <div class="rounded-xl border border-slate-800 bg-slate-900/30 p-5">
        <p class="text-xs font-semibold text-slate-500 uppercase tracking-widest mb-2">¿Necesitas ayuda?</p>
        <h3 class="text-sm font-bold text-slate-200 mb-2">
          Gestores especializados en subvenciones
        </h3>
        <p class="text-xs text-slate-400 mb-4">
          Solicitar una subvención tiene complejidad burocrática. Un gestor especializado maximiza tus probabilidades.
        </p>
        <div class="space-y-2">
          <a
            href="https://www.gestoriasdeempresa.com"
            target="_blank"
            rel="noopener noreferrer sponsored"
            class="block text-center px-4 py-2 rounded-lg border border-slate-700 bg-slate-800 hover:border-emerald-600 hover:text-emerald-400 text-slate-300 text-xs font-semibold transition-colors"
          >
            Gestoría especializada
          </a>
          <a
            href="https://www.enae.es"
            target="_blank"
            rel="noopener noreferrer sponsored"
            class="block text-center px-4 py-2 rounded-lg border border-slate-700 bg-slate-800 hover:border-emerald-600 hover:text-emerald-400 text-slate-300 text-xs font-semibold transition-colors"
          >
            Consultoría ENAE
          </a>
        </div>
      </div>

      <!-- ADSENSE -->
      <div class="min-h-[250px] rounded-xl border border-slate-800/40 bg-slate-900/20 flex items-center justify-center">
        <p class="text-xs text-slate-700">Publicidad</p>
      </div>

    </aside>
  </main>

  <!-- FOOTER -->
  <footer class="border-t border-slate-800/60 mt-10">
    <div class="max-w-5xl mx-auto px-4 py-8 flex flex-col sm:flex-row justify-between items-center gap-4 text-xs text-slate-600">
      <p>© {new Date().getFullYear()} Radar Subvenciones · Proyecto independiente</p>
      <nav class="flex flex-wrap gap-x-4 gap-y-1 justify-center">
        <a href="/origen-datos"        class="hover:text-slate-400 transition-colors">Fuentes</a>
        <a href="/aviso-legal"         class="hover:text-slate-400 transition-colors">Aviso legal</a>
        <a href="/politica-privacidad" class="hover:text-slate-400 transition-colors">Privacidad</a>
        <a href="/politica-cookies"    class="hover:text-slate-400 transition-colors">Cookies</a>
      </nav>
    </div>
  </footer>

<script>
  document.querySelectorAll<HTMLFormElement>('.js-form-telegram').forEach(form => {
    form.addEventListener('submit', async e => {
      e.preventDefault()
      const email = (form.elements.namedItem('email') as HTMLInputElement).value
      const btn = form.querySelector('button') as HTMLButtonElement
      const msg = form.closest('div')?.querySelector<HTMLElement>('.js-form-msg')
      const originalText = btn.textContent ?? ''

      btn.disabled = true
      btn.textContent = 'Enviando...'

      const res = await fetch('/api/suscribir', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email }),
      })

      if (res.ok) {
        window.location.href = 'https://t.me/RadarSubvencionesBot'
      } else {
        if (msg) { msg.textContent = 'Error al suscribirte. Inténtalo de nuevo.'; msg.classList.remove('hidden') }
        btn.disabled = false
        btn.textContent = originalText
      }
    })
  })
</script>
</Layout>
