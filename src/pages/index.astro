---
import Layout from '../layouts/Layout.astro'
import { SITE } from '../lib/config'
import NavBar from '../components/NavBar.astro'
import B2BFeedSample from '../components/B2BFeedSample.astro'

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      name: SITE.nombre,
      description: SITE.desc,
      url: SITE.siteUrl,
      inLanguage: 'es',
      potentialAction: {
        '@type': 'SearchAction',
        target: { '@type': 'EntryPoint', urlTemplate: `${SITE.siteUrl}/sector/{search_term_string}` },
        'query-input': 'required name=search_term_string',
      },
    },
    {
      '@type': 'Service',
      name: 'Feed de subvenciones para asesorías',
      description: 'Servicio de seguimiento y filtrado de subvenciones para asesorías, gestorías y despachos profesionales.',
      provider: { '@type': 'Organization', name: SITE.nombre, url: SITE.siteUrl },
      areaServed: { '@type': 'Country', name: 'Spain' },
      serviceType: 'Feed comercial de subvenciones',
      url: `${SITE.siteUrl}/asesorias`,
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: '¿Qué entrega Radar Subvenciones?',
          acceptedAnswer: { '@type': 'Answer', text: 'Un CSV o Excel con las convocatorias filtradas. Cada registro incluye título, organismo, destinatarios, territorio, importe máximo, fecha límite, prioridad, motivo de prioridad y enlace oficial.' },
        },
        {
          '@type': 'Question',
          name: '¿Para quién está pensado el producto?',
          acceptedAnswer: { '@type': 'Answer', text: 'Está pensado para asesorías, gestorías, despachos y profesionales que necesitan detectar ayudas relevantes para su cartera sin perder tiempo revisando publicaciones una a una.' },
        },
        {
          '@type': 'Question',
          name: '¿Se puede contratar de forma puntual o recurrente?',
          acceptedAnswer: { '@type': 'Answer', text: 'Sí. Hay filtrados puntuales, seguimiento recurrente y cobertura personalizada según cartera, sector o comunidad.' },
        },
        {
          '@type': 'Question',
          name: '¿Cómo se solicita una muestra?',
          acceptedAnswer: { '@type': 'Answer', text: 'Puedes escribir a josue@benchdatalab.com para pedir una muestra de Radar Subvenciones y valorar si encaja con tu despacho.' },
        },
      ],
    },
  ],
}
---

<Layout
  title="Radar Subvenciones · Feed de subvenciones para asesorías y gestorías"
  description="Feed CSV o Excel de subvenciones filtradas para asesorías y gestorías. Convocatorias clasificadas por destinatario, territorio, importe y prioridad."
  jsonLd={jsonLd}
>

  <NavBar />

  <section class="bg-gradient-to-b from-emerald-950/30 to-slate-950 border-b border-slate-800/60">
    <div class="max-w-5xl mx-auto px-4 py-14 lg:py-20">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-slate-50 leading-tight mb-4">
        Subvenciones filtradas<br class="hidden sm:block"> para asesorías y gestorías
      </h1>
      <p class="text-slate-400 text-lg max-w-2xl mb-8">
        Monitorizamos convocatorias públicas, eliminamos el ruido y entregamos un CSV o Excel con oportunidades clasificadas para tu cartera de clientes.
      </p>

      <div class="flex flex-wrap gap-3 mb-10">
        <a
          href="#contacto"
          class="inline-flex items-center justify-center px-5 py-3 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 text-sm font-bold transition-colors"
        >
          Pedir muestra por email
        </a>
        <a
          href="/asesorias"
          class="inline-flex items-center justify-center px-5 py-3 rounded-xl border border-slate-700 hover:border-emerald-600 text-slate-200 text-sm font-semibold transition-colors"
        >
          Ver solución para asesorías
        </a>
      </div>

      <div class="grid md:grid-cols-3 gap-4">
        <div class="rounded-2xl border border-slate-800 bg-slate-900/70 p-5">
          <svg class="w-5 h-5 text-slate-500 mb-3" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6l4 2m6-2a10 10 0 11-20 0 10 10 0 0120 0z"/>
          </svg>
          <p class="text-xs font-semibold uppercase tracking-widest text-slate-500 mb-2">Menos tiempo de revisión</p>
          <p class="text-sm text-slate-300">Sin depender de boletines ni búsquedas manuales. Las convocatorias relevantes llegan clasificadas.</p>
        </div>
        <div class="rounded-2xl border border-emerald-900/60 bg-emerald-950/20 p-5">
          <svg class="w-5 h-5 text-emerald-600 mb-3" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2a1 1 0 01-.293.707L13 13.414V19a1 1 0 01-.553.894l-4 2A1 1 0 017 21v-7.586L3.293 6.707A1 1 0 013 6V4z"/>
          </svg>
          <p class="text-xs font-semibold uppercase tracking-widest text-slate-500 mb-2">Entregable listo para usar</p>
          <p class="text-sm text-slate-300">CSV o Excel con prioridad, beneficiario, ámbito territorial y enlace oficial a la convocatoria.</p>
        </div>
        <div class="rounded-2xl border border-slate-800 bg-slate-900/70 p-5">
          <svg class="w-5 h-5 text-slate-500 mb-3" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
          </svg>
          <p class="text-xs font-semibold uppercase tracking-widest text-slate-500 mb-2">Cobertura adaptable</p>
          <p class="text-sm text-slate-300">Puntual o recurrente. Por sector, comunidad o tipo de cartera. Sin compromisos de permanencia.</p>
        </div>
      </div>
    </div>
  </section>

  <main class="max-w-5xl mx-auto px-4 py-10 space-y-10">
    <section id="como-funciona" class="rounded-2xl border border-slate-800 bg-slate-900/60 p-6">
      <h2 class="text-xl font-bold text-slate-100 mb-5">Cómo funciona</h2>
      <div class="grid md:grid-cols-4 gap-4 text-sm text-slate-300">
        <div>
          <span class="block text-2xl font-bold text-slate-700 leading-none mb-3">01</span>
          <p class="text-xs font-semibold uppercase tracking-widest text-emerald-400 mb-2">Seguimiento</p>
          <p>Seguimos ayudas relevantes para que tu despacho no dependa de revisar publicaciones una a una.</p>
        </div>
        <div>
          <span class="block text-2xl font-bold text-slate-700 leading-none mb-3">02</span>
          <p class="text-xs font-semibold uppercase tracking-widest text-emerald-400 mb-2">Filtrado</p>
          <p>Quitamos ruido y priorizamos oportunidades con valor para pymes, autónomos, empresas y empleo.</p>
        </div>
        <div>
          <span class="block text-2xl font-bold text-slate-700 leading-none mb-3">03</span>
          <p class="text-xs font-semibold uppercase tracking-widest text-emerald-400 mb-2">Entrega</p>
          <p>Recibes un CSV o Excel claro, preparado para compartir, revisar o activar con tu cartera.</p>
        </div>
        <div>
          <span class="block text-2xl font-bold text-slate-700 leading-none mb-3">04</span>
          <p class="text-xs font-semibold uppercase tracking-widest text-emerald-400 mb-2">Acción</p>
          <p>Tu equipo decide qué mover antes y con qué cobertura: puntual, recurrente o personalizada.</p>
        </div>
      </div>
    </section>

    <section class="rounded-2xl border border-slate-800 bg-slate-900/40 p-6">
      <h2 class="text-xl font-bold text-slate-100 mb-5">Modalidades de servicio</h2>
      <div class="grid md:grid-cols-3 gap-5">
        <article class="rounded-xl border border-slate-800 bg-slate-900/70 p-5">
          <span class="block text-2xl font-bold text-slate-700 leading-none mb-4">01</span>
          <p class="text-xs font-semibold uppercase tracking-widest text-slate-500 mb-2">Filtrado puntual</p>
          <p class="text-sm text-slate-300">Selecciones concretas para una campaña, un cliente relevante o una necesidad inmediata.</p>
        </article>
        <article class="rounded-xl border border-emerald-800/40 bg-emerald-950/20 p-5">
          <span class="block text-2xl font-bold text-emerald-900 leading-none mb-4">02</span>
          <p class="text-xs font-semibold uppercase tracking-widest text-emerald-400 mb-2">Seguimiento recurrente</p>
          <p class="text-sm text-slate-300">Cobertura periódica para despachos que necesitan detectar oportunidades de forma continua.</p>
        </article>
        <article class="rounded-xl border border-slate-800 bg-slate-900/70 p-5">
          <span class="block text-2xl font-bold text-slate-700 leading-none mb-4">03</span>
          <p class="text-xs font-semibold uppercase tracking-widest text-slate-500 mb-2">Cobertura personalizada</p>
          <p class="text-sm text-slate-300">Ajustes por tipo de cartera, comunidad, vertical o perfil de cliente.</p>
        </article>
      </div>
    </section>

    <section class="rounded-2xl border border-slate-800 bg-gradient-to-br from-slate-900/80 to-slate-950 p-6">
      <h2 class="text-xl font-bold text-slate-100 mb-5">Casos de uso</h2>
      <div class="grid md:grid-cols-3 gap-4 text-sm">
        <div class="rounded-xl border border-slate-800 bg-slate-950/60 p-4">
          <svg class="w-4 h-4 text-slate-500 mb-3" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 21h16.5M4.5 3h15M5.25 3v18m13.5-18v18M9 6.75h1.5m-1.5 3h1.5m-1.5 3h1.5m3-6H15m-1.5 3H15m-1.5 3H15M9 21v-3.375c0-.621.504-1.125 1.125-1.125h3.75c.621 0 1.125.504 1.125 1.125V21"/>
          </svg>
          <p class="font-semibold text-slate-100 mb-2">Despachos con cartera pyme</p>
          <p class="text-slate-400">Seguimiento de ayudas para inversión, contratación, digitalización o expansión.</p>
        </div>
        <div class="rounded-xl border border-slate-800 bg-slate-950/60 p-4">
          <svg class="w-4 h-4 text-slate-500 mb-3" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/>
          </svg>
          <p class="font-semibold text-slate-100 mb-2">Gestorías locales</p>
          <p class="text-slate-400">Filtrados puntuales para comercio local, hostelería, autónomos o empresas de la zona.</p>
        </div>
        <div class="rounded-xl border border-slate-800 bg-slate-950/60 p-4">
          <svg class="w-4 h-4 text-slate-500 mb-3" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 13.5V3.75m0 9.75a1.5 1.5 0 010 3m0-3a1.5 1.5 0 000 3m0 3.75V16.5m12-3V3.75m0 9.75a1.5 1.5 0 010 3m0-3a1.5 1.5 0 000 3m0 3.75V16.5m-6-9V3.75m0 3.75a1.5 1.5 0 010 3m0-3a1.5 1.5 0 000 3m0 9.75V10.5"/>
          </svg>
          <p class="font-semibold text-slate-100 mb-2">Coberturas a medida</p>
          <p class="text-slate-400">Seguimiento recurrente por comunidad, tipo de cliente o vertical, con información clasificada desde el primer entregable.</p>
        </div>
      </div>
    </section>

    <B2BFeedSample />

    <section class="rounded-2xl border border-slate-800 bg-slate-900/50 p-6">
      <h2 class="text-xl font-bold text-slate-100 mb-5">Preguntas frecuentes</h2>
      <div class="grid md:grid-cols-2 gap-4 text-sm">
        <div class="rounded-xl border border-slate-800 bg-slate-950/60 p-4">
          <span class="block text-xs font-bold text-slate-600 mb-2">—</span>
          <p class="font-semibold text-slate-100 mb-2">¿Qué recibo exactamente?</p>
          <p class="text-slate-400">Un CSV o Excel con las convocatorias filtradas. Cada registro incluye título, organismo, destinatarios, territorio, importe máximo, fecha límite, prioridad, motivo de prioridad y enlace oficial.</p>
        </div>
        <div class="rounded-xl border border-slate-800 bg-slate-950/60 p-4">
          <span class="block text-xs font-bold text-slate-600 mb-2">—</span>
          <p class="font-semibold text-slate-100 mb-2">¿Es solo para gestorías grandes?</p>
          <p class="text-slate-400">No. Encaja tanto en despachos pequeños como en equipos con seguimiento recurrente de ayudas.</p>
        </div>
        <div class="rounded-xl border border-slate-800 bg-slate-950/60 p-4">
          <span class="block text-xs font-bold text-slate-600 mb-2">—</span>
          <p class="font-semibold text-slate-100 mb-2">¿Se puede pedir algo puntual?</p>
          <p class="text-slate-400">Sí. Hay filtrados puntuales, seguimiento recurrente y cobertura personalizada.</p>
        </div>
        <div class="rounded-xl border border-slate-800 bg-slate-950/60 p-4">
          <span class="block text-xs font-bold text-slate-600 mb-2">—</span>
          <p class="font-semibold text-slate-100 mb-2">¿Cómo solicito una muestra?</p>
          <p class="text-slate-400">Escríbenos y te enviamos una muestra para valorar el encaje con tu despacho.</p>
        </div>
      </div>
    </section>

    <section id="contacto" class="rounded-2xl border border-emerald-900/50 bg-gradient-to-br from-emerald-950/30 to-slate-950 p-8 lg:p-12 text-center">
      <p class="text-xs font-semibold uppercase tracking-widest text-emerald-400 mb-4">Contacto directo</p>
      <h2 class="text-2xl sm:text-3xl font-bold text-slate-100 mb-4">Solicita una muestra</h2>
      <p class="text-slate-400 max-w-xl mx-auto mb-8">
        Escríbenos y te enviamos un CSV o Excel con oportunidades reales para que valores el encaje con tu despacho. Sin compromiso.
      </p>
      <button type="button" class="inline-flex items-center justify-center px-6 py-3 rounded-xl bg-emerald-500 text-slate-950 text-sm font-bold cursor-default select-none">
        Escribir para solicitar muestra
      </button>
      <p class="text-sm text-slate-400 mt-5">
        <span class="text-emerald-400">josue@benchdatalab.com</span>
      </p>
    </section>
  </main>

  <footer class="border-t border-slate-800/40 mt-10">
    <div class="max-w-5xl mx-auto px-4 py-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs text-slate-600">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
        <span class="text-slate-400 font-medium">Radar Subvenciones</span>
        <span class="text-slate-700">·</span>
        <span>Un producto de <a href="https://benchdatalab.com" class="hover:text-slate-400 transition-colors" target="_blank" rel="noreferrer">BenchDataLab</a></span>
      </div>
      <nav class="flex flex-wrap items-center gap-x-3 gap-y-1">
        <a href="/aviso-legal" class="text-slate-700 hover:text-slate-500 transition-colors">Aviso legal</a>
        <a href="/politica-privacidad" class="text-slate-700 hover:text-slate-500 transition-colors">Privacidad</a>
        <a href="/politica-cookies" class="text-slate-700 hover:text-slate-500 transition-colors">Cookies</a>
      </nav>
    </div>
  </footer>

</Layout>
