---
import Layout from '../layouts/Layout.astro'
import { createClient } from '@supabase/supabase-js'
import { SITE } from '../lib/config'
import { SECTORES, CCAA } from '../lib/taxonomia'
import { subvencionSlug } from '../lib/slugify'
import NavBar from '../components/NavBar.astro'

const supabase = createClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.PUBLIC_SUPABASE_KEY,
)

const { data: subvenciones } = await supabase
  .from('subvenciones')
  .select('id, titulo, descripcion, fuente, tipo, fecha_pub, url')
  .order('fecha_pub', { ascending: false, nullsFirst: false })
  .limit(50)

const { count: totalBD } = await supabase
  .from('subvenciones')
  .select('*', { count: 'exact', head: true })

const total = subvenciones?.length ?? 0
const totalConvocatorias = totalBD ?? 0

const TIPO_META: Record<string, { label: string; color: string }> = {
  convocatoria: { label: 'Convocatoria',  color: 'text-emerald-400 bg-emerald-950/60 ring-emerald-700/50' },
  extracto:     { label: 'Extracto BOE',  color: 'text-sky-400 bg-sky-950/60 ring-sky-700/50' },
  bases:        { label: 'Bases',          color: 'text-amber-400 bg-amber-950/60 ring-amber-700/50' },
  resolucion:   { label: 'Resolución',    color: 'text-rose-400 bg-rose-950/60 ring-rose-700/50' },
}
function tipoMeta(tipo: string) {
  return TIPO_META[tipo] ?? { label: tipo ?? 'Ayuda', color: 'text-slate-400 bg-slate-800 ring-slate-700/50' }
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      name: SITE.nombre,
      description: SITE.desc,
      url: SITE.siteUrl,
      inLanguage: 'es',
      potentialAction: {
        '@type': 'SearchAction',
        target: { '@type': 'EntryPoint', urlTemplate: `${SITE.siteUrl}/sector/{search_term_string}` },
        'query-input': 'required name=search_term_string',
      },
    },
    {
      '@type': 'Service',
      name: 'Feed de subvenciones para asesorías',
      description: 'Feed recurrente para gestorías, asesorías y consultoras con convocatorias filtradas y priorizadas.',
      provider: { '@type': 'Organization', name: SITE.nombre, url: SITE.siteUrl },
      areaServed: { '@type': 'Country', name: 'Spain' },
      serviceType: 'Data feed B2B de subvenciones',
      url: `${SITE.siteUrl}/asesorias`,
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: '¿Qué es una subvención pública en España?',
          acceptedAnswer: { '@type': 'Answer', text: 'Una subvención pública es una ayuda económica concedida por organismos del Estado, comunidades autónomas o ayuntamientos a empresas, autónomos o particulares para financiar actividades de interés general, sin obligación de devolución.' },
        },
        {
          '@type': 'Question',
          name: '¿Dónde se publican las convocatorias de subvenciones en España?',
          acceptedAnswer: { '@type': 'Answer', text: 'Las subvenciones estatales se publican en el Boletín Oficial del Estado (BOE) y en la Base de Datos Nacional de Subvenciones (BDNS). Cada comunidad autónoma tiene además su propio boletín oficial. Radar Subvenciones agrega todas estas fuentes en un solo lugar.' },
        },
        {
          '@type': 'Question',
          name: '¿Qué es el BDNS?',
          acceptedAnswer: { '@type': 'Answer', text: 'El BDNS (Base de Datos Nacional de Subvenciones) es el registro oficial del Ministerio de Hacienda donde se publican todas las convocatorias de subvenciones y ayudas públicas en España.' },
        },
        {
          '@type': 'Question',
          name: '¿Quién puede solicitar subvenciones públicas en España?',
          acceptedAnswer: { '@type': 'Answer', text: 'Pueden solicitar subvenciones personas físicas (autónomos, particulares), personas jurídicas (empresas, pymes, asociaciones, ONG) y entidades públicas, dependiendo de los requisitos de cada convocatoria.' },
        },
        {
          '@type': 'Question',
          name: '¿Con qué frecuencia se actualiza Radar Subvenciones?',
          acceptedAnswer: { '@type': 'Answer', text: 'Radar Subvenciones se actualiza automáticamente cada día laborable extrayendo las nuevas convocatorias del BOE y el BDNS, por lo que siempre muestra las ayudas más recientes disponibles.' },
        },
      ],
    },
  ],
}
---

<Layout jsonLd={jsonLd}>

  <NavBar />

  <!-- HERO -->
  <section class="bg-gradient-to-b from-emerald-950/30 to-slate-950 border-b border-slate-800/60">
    <div class="max-w-5xl mx-auto px-4 py-14 lg:py-20">
      <p class="text-emerald-400 text-xs font-semibold uppercase tracking-widest mb-3">
        MVP B2B para asesorías · BOE + BDNS
      </p>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-slate-50 leading-tight mb-4">
        El radar comercial de subvenciones<br class="hidden sm:block"> para asesorías y gestorías
      </h1>
      <p class="text-slate-400 text-lg max-w-2xl mb-8">
        Recibe un feed CSV/Excel de subvenciones filtradas para mover oportunidades con pymes, autónomos y empresas sin leer boletines durante horas.
      </p>

      <div class="flex flex-wrap gap-3 mb-8">
        <a
          href="/asesorias"
          class="inline-flex items-center justify-center px-5 py-3 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 text-sm font-bold transition-colors"
        >
          Pedir muestra del feed
        </a>
        <a
          href="/asesorias#como-funciona"
          class="inline-flex items-center justify-center px-5 py-3 rounded-xl border border-slate-700 hover:border-emerald-600 text-slate-200 text-sm font-semibold transition-colors"
        >
          Ver cómo funciona
        </a>
      </div>

      <!-- ESTADÍSTICAS -->
      <div class="flex flex-wrap gap-6 mb-8">
        <div>
          <p class="text-2xl font-extrabold text-emerald-400">{totalConvocatorias.toLocaleString('es-ES')}+</p>
          <p class="text-xs text-slate-500 mt-0.5">convocatorias monitorizadas</p>
        </div>
        <div>
          <p class="text-2xl font-extrabold text-emerald-400">17</p>
          <p class="text-xs text-slate-500 mt-0.5">comunidades autónomas</p>
        </div>
        <div>
          <p class="text-2xl font-extrabold text-emerald-400">Diario</p>
          <p class="text-xs text-slate-500 mt-0.5">ingesta y clasificación</p>
        </div>
        <div>
          <p class="text-2xl font-extrabold text-emerald-400">B2B</p>
          <p class="text-xs text-slate-500 mt-0.5">feed para despachos</p>
        </div>
      </div>

      <div class="grid md:grid-cols-3 gap-4">
        <div class="rounded-2xl border border-slate-800 bg-slate-900/50 p-4">
          <p class="text-xs font-semibold uppercase tracking-widest text-slate-500 mb-2">Qué vendes</p>
          <p class="text-sm text-slate-300">Tiempo ahorrado, detección temprana y oportunidades filtradas para clientes reales.</p>
        </div>
        <div class="rounded-2xl border border-slate-800 bg-slate-900/50 p-4">
          <p class="text-xs font-semibold uppercase tracking-widest text-slate-500 mb-2">Qué recibes</p>
          <p class="text-sm text-slate-300">CSV o Excel con score comercial, prioridad, ámbito, sector, beneficiario y enlace oficial.</p>
        </div>
        <div class="rounded-2xl border border-slate-800 bg-slate-900/50 p-4">
          <p class="text-xs font-semibold uppercase tracking-widest text-slate-500 mb-2">Dónde empieza</p>
          <p class="text-sm text-slate-300">BOE y BDNS hoy. Más fuentes oficiales conforme endurezcamos el motor.</p>
        </div>
      </div>
    </div>
  </section>

<main class="max-w-5xl mx-auto px-4 py-10 grid lg:grid-cols-[1fr_300px] gap-10">

    <!-- LISTADO PRINCIPAL -->
    <section>
      <h2 class="text-sm font-semibold text-slate-400 uppercase tracking-widest mb-5">
        Muestra pública del radar
      </h2>

      {(subvenciones ?? []).length === 0 ? (
        <p class="text-slate-500 text-sm">El radar actualiza diariamente. Vuelve pronto.</p>
      ) : (
        <ol class="space-y-4">
          {(subvenciones ?? []).map(s => {
            const tm = tipoMeta(s.tipo)
            const slug = subvencionSlug(s.titulo ?? '', s.id)
            const fecha = s.fecha_pub
              ? new Date(s.fecha_pub).toLocaleDateString('es-ES', { day: '2-digit', month: 'short', year: 'numeric' })
              : null
            return (
              <li class="rounded-xl border border-slate-800 bg-slate-900/50 hover:border-emerald-800/60 hover:bg-slate-900 transition-colors overflow-hidden flex">
                <div class="w-1 bg-emerald-700/40 shrink-0 group-hover:bg-emerald-500"></div>
                <div class="p-5 flex-1 min-w-0">
                  <div class="flex flex-wrap items-center gap-2 mb-2">
                    <span class={`inline-flex items-center gap-1 text-[11px] font-semibold px-2 py-0.5 rounded-full ring-1 ${tm.color}`}>
                      {tm.label}
                    </span>
                    {fecha && <time class="text-xs text-slate-500 ml-auto">{fecha}</time>}
                  </div>

                  <a href={`/subvencion/${slug}`} class="block text-base font-semibold text-slate-100 leading-snug mb-2 hover:text-emerald-400 transition-colors">
                    {s.titulo}
                  </a>

                  {s.descripcion && (
                    <p class="text-xs text-slate-500 leading-relaxed line-clamp-2">
                      {s.descripcion.slice(0, 200)}
                    </p>
                  )}
                </div>
              </li>
            )
          })}
        </ol>
      )}
    </section>

    <!-- SIDEBAR -->
    <aside class="space-y-6">

      <!-- POR CCAA -->
      <div class="rounded-xl border border-slate-800 bg-slate-900/50 p-5">
        <h3 class="text-xs font-semibold text-slate-400 uppercase tracking-widest mb-4">Por comunidad autónoma</h3>
        <ul class="space-y-1">
          {CCAA.map(c => (
            <li>
              <a href={`/ccaa/${c.slug}`} class="text-sm text-slate-400 hover:text-emerald-400 transition-colors block py-0.5">
                {c.nombre}
              </a>
            </li>
          ))}
        </ul>
      </div>


      <!-- CTA ASESORIAS -->
      <div class="rounded-xl border border-emerald-800/40 bg-emerald-950/20 p-5">
        <p class="text-xs font-semibold text-emerald-400 uppercase tracking-widest mb-2">Producto para despachos</p>
        <h3 class="text-sm font-bold text-slate-200 mb-2">
          Feed semanal para asesorías y gestorías
        </h3>
        <p class="text-xs text-slate-400 mb-4">
          Convocatorias clasificadas, priorizadas y listas para mover con tu cartera de clientes.
        </p>
        <div class="space-y-2">
          <a
            href="/asesorias"
            class="block text-center px-4 py-2 rounded-lg bg-emerald-500 hover:bg-emerald-400 text-slate-950 text-xs font-bold transition-colors"
          >
            Pedir muestra del feed
          </a>
          <a
            href="/asesorias#como-funciona"
            class="block text-center px-4 py-2 rounded-lg border border-slate-700 bg-slate-800 hover:border-emerald-600 hover:text-emerald-400 text-slate-300 text-xs font-semibold transition-colors"
          >
            Ver cómo funciona
          </a>
        </div>
      </div>

      <!-- ADSENSE -->
      <div class="min-h-[250px] rounded-xl border border-slate-800/40 bg-slate-900/20 flex items-center justify-center">
        <p class="text-xs text-slate-700">Publicidad</p>
      </div>

    </aside>
  </main>

  <section id="lead-b2b-home" class="max-w-5xl mx-auto px-4 pb-12">
    <div class="rounded-2xl border border-slate-800 bg-slate-900/50 p-6 lg:p-7">
      <div class="grid lg:grid-cols-[0.9fr_1.1fr] gap-6 items-start">
        <div>
          <p class="text-xs font-semibold uppercase tracking-widest text-emerald-400 mb-3">Captación B2B</p>
          <h2 class="text-2xl font-bold text-slate-100 mb-3">Pide una muestra del feed para asesorías</h2>
          <p class="text-sm text-slate-400">
            Si llevas pymes, autónomos o empresas, te enseñamos cómo llega la información operativa: score comercial, prioridad, sector, ámbito y enlace oficial.
          </p>
        </div>
        <form id="lead-home-form" class="grid sm:grid-cols-2 gap-4">
          <input type="hidden" name="tipo_despacho" value="Lead desde home" />
          <label class="block sm:col-span-1">
            <span class="text-xs text-slate-400 mb-1 block">Nombre</span>
            <input name="nombre" required class="w-full rounded-xl border border-slate-700 bg-slate-950 px-4 py-3 text-sm text-slate-100 outline-none focus:border-emerald-500" />
          </label>
          <label class="block sm:col-span-1">
            <span class="text-xs text-slate-400 mb-1 block">Empresa</span>
            <input name="empresa" required class="w-full rounded-xl border border-slate-700 bg-slate-950 px-4 py-3 text-sm text-slate-100 outline-none focus:border-emerald-500" />
          </label>
          <label class="block sm:col-span-2">
            <span class="text-xs text-slate-400 mb-1 block">Email profesional</span>
            <input type="email" name="email" required class="w-full rounded-xl border border-slate-700 bg-slate-950 px-4 py-3 text-sm text-slate-100 outline-none focus:border-emerald-500" />
          </label>
          <label class="block sm:col-span-2">
            <span class="text-xs text-slate-400 mb-1 block">Interés principal</span>
            <select name="interes" class="w-full rounded-xl border border-slate-700 bg-slate-950 px-4 py-3 text-sm text-slate-100 outline-none focus:border-emerald-500">
              <option value="">No especificado</option>
              <option>Feed semanal</option>
              <option>Alertas urgentes</option>
              <option>Segmentación por sector</option>
              <option>Segmentación por comunidad</option>
            </select>
          </label>
          <div class="sm:col-span-2 flex flex-wrap items-center gap-3">
            <button type="submit" class="inline-flex items-center justify-center px-5 py-3 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 text-sm font-bold transition-colors">
              Pedir muestra del feed
            </button>
            <p id="lead-home-status" class="text-sm text-slate-400"></p>
          </div>
          <p class="sm:col-span-2 text-xs text-slate-500">Usaremos tus datos solo para responder y enviarte una muestra del feed. Sin listas masivas ni cesión a terceros.</p>
        </form>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="border-t border-slate-800/60 mt-10">
    <div class="max-w-5xl mx-auto px-4 py-8 flex flex-col sm:flex-row justify-between items-center gap-4 text-xs text-slate-600">
      <p>© {new Date().getFullYear()} Radar Subvenciones · Proyecto independiente</p>
      <nav class="flex flex-wrap gap-x-4 gap-y-1 justify-center">
        <a href="/origen-datos"        class="hover:text-slate-400 transition-colors">Fuentes</a>
        <a href="/aviso-legal"         class="hover:text-slate-400 transition-colors">Aviso legal</a>
        <a href="/politica-privacidad" class="hover:text-slate-400 transition-colors">Privacidad</a>
        <a href="/politica-cookies"    class="hover:text-slate-400 transition-colors">Cookies</a>
      </nav>
    </div>
  </footer>

  <script>
    async function bindLeadForm(formId, statusId) {
      const form = document.getElementById(formId);
      const status = document.getElementById(statusId);
      if (!form || !status) return;

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        status.textContent = 'Enviando...';
        status.className = 'text-sm text-slate-400';

        const formData = new FormData(form);
        const payload = Object.fromEntries(formData.entries());

        try {
          const res = await fetch('/api/lead-asesoria', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          const data = await res.json();
          if (!res.ok) throw new Error(data.error || 'No se pudo enviar');
          form.reset();
          status.textContent = 'Recibido. Te contactaremos con una muestra del feed.';
          status.className = 'text-sm text-emerald-400';
        } catch (error) {
          status.textContent = error instanceof Error ? error.message : 'Ha fallado el envío';
          status.className = 'text-sm text-rose-400';
        }
      });
    }

    bindLeadForm('lead-home-form', 'lead-home-status');
  </script>

</Layout>
