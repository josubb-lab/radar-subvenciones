---
interface BreadcrumbItem {
  label: string
  href?: string
}
interface Props {
  breadcrumb?: BreadcrumbItem[]
}
const { breadcrumb } = Astro.props

const navLinks = [
  { href: '/',                 label: 'Inicio' },
  { href: '/asesorias',        label: 'Asesorías' },
  { href: '/#como-funciona',   label: 'Cómo funciona' },
  { href: '/quienes-somos',    label: 'Quiénes somos' },
  { href: 'mailto:josue@benchdatalab.com?subject=Solicitud%20Radar%20Subvenciones', label: 'Escribir' },
]
---

<nav class="border-b border-slate-800 bg-slate-950/90 backdrop-blur sticky top-0 z-40">
  <div class="max-w-5xl mx-auto px-4 py-3 flex items-center justify-between gap-4">

    <!-- Logo + breadcrumb -->
    <div class="flex items-center gap-3 text-sm min-w-0">
      <a href="/" class="shrink-0 leading-tight group">
        <div class="flex items-start gap-2">
          <span class="text-emerald-400 mt-0.5">◈</span>
          <div>
            <span class="block font-bold text-slate-100 group-hover:text-emerald-400 transition-colors">
              Radar Subvenciones
            </span>
            <span class="block text-[11px] text-slate-500">
              Un producto de BenchDataLab
            </span>
          </div>
        </div>
      </a>
      {breadcrumb?.map(item => (
        <>
          <span class="text-slate-700 shrink-0">/</span>
          {item.href
            ? <a href={item.href} class="text-slate-400 hover:text-slate-100 transition-colors truncate">{item.label}</a>
            : <span class="text-slate-500 truncate">{item.label}</span>
          }
        </>
      ))}
    </div>

    <!-- Desktop nav -->
    <div class="hidden sm:flex items-center gap-5 text-sm text-slate-400 shrink-0">
      {navLinks.map(l => (
        <a href={l.href} class="hover:text-slate-100 transition-colors">{l.label}</a>
      ))}
    </div>

    <!-- Hamburguesa móvil -->
    <button id="nav-toggle" class="sm:hidden p-1.5 text-slate-400 hover:text-slate-100 shrink-0" aria-label="Menú">
      <svg id="nav-icon-open" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
      <svg id="nav-icon-close" class="w-5 h-5 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>

  </div>

  <!-- Menú móvil desplegable -->
  <div id="nav-mobile" class="hidden border-t border-slate-800 bg-slate-950/95">
    <div class="max-w-5xl mx-auto px-4 py-2 flex flex-col">
      {navLinks.map(l => (
        <a href={l.href} class="text-sm text-slate-300 hover:text-emerald-400 py-2.5 border-b border-slate-800/60 last:border-0 transition-colors">
          {l.label}
        </a>
      ))}
    </div>
  </div>
</nav>

<script>
  const toggle = document.getElementById('nav-toggle')
  const menu   = document.getElementById('nav-mobile')
  const iconOpen  = document.getElementById('nav-icon-open')
  const iconClose = document.getElementById('nav-icon-close')

  toggle?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden')
    menu?.classList.toggle('hidden', isOpen)
    iconOpen?.classList.toggle('hidden', !isOpen)
    iconClose?.classList.toggle('hidden', isOpen)
  })
</script>
