---
interface BreadcrumbItem {
  label: string
  href?: string
}
interface Props {
  breadcrumb?: BreadcrumbItem[]
}
const { breadcrumb } = Astro.props

const navLinks = [
  { href: '/sector/autonomos', label: 'Autónomos' },
  { href: '/sector/empresas',  label: 'Empresas' },
  { href: '/sector/empleo',    label: 'Empleo' },
  { href: '/guias',            label: 'Guías' },
  { href: '/quienes-somos',   label: 'Nosotros' },
]
---

<nav class="border-b border-slate-800 bg-slate-950/90 backdrop-blur sticky top-0 z-40">
  <div class="max-w-5xl mx-auto px-4 h-14 flex items-center justify-between gap-4">

    <!-- Logo + breadcrumb -->
    <div class="flex items-center gap-2 text-sm min-w-0">
      <a href="/" class="font-bold text-slate-100 hover:text-emerald-400 transition-colors shrink-0">
        <span class="text-emerald-400">◈</span>
        <span class="hidden sm:inline"> Radar Subvenciones</span>
        <span class="sm:hidden"> Radar</span>
      </a>
      {breadcrumb?.map(item => (
        <>
          <span class="text-slate-700 shrink-0">/</span>
          {item.href
            ? <a href={item.href} class="text-slate-400 hover:text-slate-100 transition-colors truncate">{item.label}</a>
            : <span class="text-slate-500 truncate">{item.label}</span>
          }
        </>
      ))}
    </div>

    <!-- Desktop nav -->
    <div class="hidden sm:flex items-center gap-5 text-sm text-slate-400 shrink-0">
      {navLinks.map(l => (
        <a href={l.href} class="hover:text-slate-100 transition-colors">{l.label}</a>
      ))}
    </div>

    <!-- Hamburguesa móvil -->
    <button id="nav-toggle" class="sm:hidden p-1.5 text-slate-400 hover:text-slate-100 shrink-0" aria-label="Menú">
      <svg id="nav-icon-open" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
      <svg id="nav-icon-close" class="w-5 h-5 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>

  </div>

  <!-- Menú móvil desplegable -->
  <div id="nav-mobile" class="hidden border-t border-slate-800 bg-slate-950/95">
    <div class="max-w-5xl mx-auto px-4 py-2 flex flex-col">
      {navLinks.map(l => (
        <a href={l.href} class="text-sm text-slate-300 hover:text-emerald-400 py-2.5 border-b border-slate-800/60 last:border-0 transition-colors">
          {l.label}
        </a>
      ))}
    </div>
  </div>
</nav>

<script>
  const toggle = document.getElementById('nav-toggle')
  const menu   = document.getElementById('nav-mobile')
  const iconOpen  = document.getElementById('nav-icon-open')
  const iconClose = document.getElementById('nav-icon-close')

  toggle?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden')
    menu?.classList.toggle('hidden', isOpen)
    iconOpen?.classList.toggle('hidden', !isOpen)
    iconClose?.classList.toggle('hidden', isOpen)
  })
</script>
